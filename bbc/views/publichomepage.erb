<!DOCTYPE html>
<head>
    <link href="../public/css/UniversalStyle.css" rel="stylesheet">
</head>
<body>
    <header>
        <section class="header-bar">
            <nav>
                <ul>
                    <li>Home</li>
                    <li>Order history</li>
                    <li>Contact us</li>
                    <li>Log in</li>
                </ul>
            </nav>
        </section>
    </header>

    <main>
        <section class="opening-hook">
            <!--<h2>BBC Logo goes here!</h2>-->
            <img src="../images/Logo.png" alt="Oh no! The logo has gone for a walk...">
            <div class="small-button-wrapper">
                <button type="button">↓</button>
            </div>
        </section>
        <section class="user-stats">
            <div class="full-span-card">
                <h1>Your statistics</h1>
                <div class="grid-container">
                    <div class="grid-span-card">
                        <h2># Coffees bought</h2>
                        <p>Data</p>
                    </div>
                    <div class="grid-span-card">
                        <h2># Coffees till freebie</h2>
                        <p>Data</p>
                    </div>
                    <div class="grid-span-card">
                        <h2># Shop locations</h2>
                        <p>Data</p>
                    </div>
                </div>
            </div>
        </section>
        <section class="bean-deals">
            <div class="full-span-card">
                <h1>New deals</h1>
                <p>Place new bean deals here.</p>
            </div>
        </section>
        <section class="order-history">
            <div class="full-span-card">
                <h1>Order history</h1>
                <p>Place user order history here.</p>
            </div>
        </section>
    </main>

    <footer>
        <section class="contact-us">
            <h1>Contact us</h1>
        </section>
    </footer>
</body>
