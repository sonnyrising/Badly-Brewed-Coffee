<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Order History</title>
</head>
<body>
    <header>
        <section class="header-bar">
            <nav>
                <ul>
                    <li><a class="smooth-link" href="/userhomepage">Dashboard</a></li>
