<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Accounts</title>
    <style>
      * body{
        overflow:visible;
      }
    </style>

</head>
<body>
    <header>
        <nav>
        <h1 style="color:black;float: left;margin-left: 1vw;;">Accounts</h1>
        <ul style="position:absolute; top:1vh;">
            <li><a href="/staff" class="smooth-link">Dashboard</a></li>
            <li><a href="/staff" class="smooth-link">Orders</a></li>
            <li><a href="/staff/accounts" class="smooth-link">Accounts</a></li>
            <li><a href="/staff/feedback" class="smooth-link">Feedback</a></li>
            <li><a href="/staff/settings" class="smooth-link">Settings</a></li>
            <li><a href="/" class="smooth-link">Log out</a></li>
        </ul>
        </nav>
    </header>
    <main>
      <div style="background-color: rgb(211, 112, 0); height: 100vh;">
        <img src="/imgs/dashboard.png" alt="Dashboard" style="width: 100%;height: 100%;object-fit: fill;">

        <div style="display: flex;flex-direction: row;flex-wrap:nowrap;justify-content: center;gap: 32px;height: 96vh;position: absolute;top: 10vh;left:50vw;transform:translateX(-50%);">
          <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;width:94vw;align-items: center;">
            <h1><%= Users.GetUsername(@userId) %></h1>
            <div style="display: grid;grid-template-columns: 100%;gap: 1vh;text-align: left;" >
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; left:5vw;">Account ID:</b>
                <%= @userId %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; left:5vw;">Account username:</b>
                <%= Users.GetUsername(@userId) %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; left:5vw;">Account email:</b>
                <%= Users.GetEmail(@userId) %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; left:5vw;">Loyalty points:</b>
                <%= Users.GetLoyaltyPoints(@userId) %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; left:5vw;">Shipping address:</b>
                <%= Users.GetEmail(@userId) %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; left:5vw;">Order quantity:</b>
                <%= Users.GetEmail(@userId) %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; left:5vw;">Inactivity period:</b>
                <%= Users.GetInactivity(@userId) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <footer>

    </footer>
</body>