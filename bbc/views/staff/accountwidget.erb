<div>
    <div style="display: flex;flex-direction: row;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px;width: 94vw;">
        <style>
            .danger-button:hover{
                background-color: rgb(255, 94, 94);
            }
        </style>
        <h3 style="margin-left: 10%;"><%= Users.GetUsername(userId) %></h3>
        <div style="display: grid; grid-template-columns: 5vw 5vw 5vw;position:absolute; right:5%">
            <form method="post" action="/staff/staffaccountview/view">
                <button type="submit">View</button>
                <input type="hidden" name="userId" value="<%= userId %>">
            </form>
            <form method="post" action="/staff/generatelabel">
                <button type="submit">Print Label</button>
                <input type="hidden" name="userId" value="<%= userId %>">
            </form>
            </form>
        </div>
    </div>
</div>