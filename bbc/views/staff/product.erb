<!DOCTYPE html>

<div class="product-box <%= 'out-of-stock' if p.StockQuantity.to_i <= 0 %>">  

  <% if p.StockQuantity.to_i <= 0 %>
    <div class="sold-out-banner">OUT OF STOCK</div>
  <% end %>
  
  <img src="/imgs/<%= p.ProductImage %>" alt="Coffee" class="product-image">
  <h3><%= p.ProductName %></h3>
  <p><%= p.ProductDescription %></p>
  <p>Roast: <%= p.Roast %></p>
  <p>Origin: <%= p.Origin %></p>
  <b>£<%= p.Price %></b>
  <form action="/staff/shop" method="post">
    <input type="hidden" name="productId" value="<%= p.ProductId %>">
    <input type="hidden" name="userId" value="<%= session[:userId]%>">
    
    <label for="quantity">Select a quantity</label>
      <select name="quantity">
        <%max_available = [p.StockQuantity.to_i, 10].min %>
        <% (1..max_available).each do |q| %>
          <option value="<%= q %>"><%= q %></option>
        <% end %>
      </select>

    <% if p.ProductId > 6 %>
        <label for="Size">Size</label>
          <select name="Size">
            <option value="Small">Small</option>
            <option value="Medium">Medium</option>
            <option value="Large">Large</option>
          </select>

        <label for="milkType">Milk Type</label>
          <select name="milkType">
            <option value="Whole Milk">Whole Milk</option>
            <option value="Soy Milk">Soy Milk</option>
            <option value="Oat Milk">Oat Milk</option>
          </select>

    <% end %>

    <button type="submit" style="cursor: pointer;">Add to basket</button>
  </form>
</div>  