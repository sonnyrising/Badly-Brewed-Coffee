<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Staff Homepage</title>
    <style>
    button {
      background-color: rgb(130 72 24);
      border: none;
      color: white;
      padding: 10px 20px;
      margin: 30px;
      text-align: center;
      text-decoration: none;
      display: inline-block;
      font: 16pt Helvetica, bold;
    }

    column-buttons {
      display: flex;              
      flex-direction: column;     
      align-items: center;        
      gap: 30px;
      margin-top: 50px;

    }


    .pie-chart {
	    background:
		  radial-gradient(
			  circle closest-side,
			  white 0,
			  white 55.38%,
			  transparent 55.38%,
			  transparent 78%,
			  white 0
		  ),
		  conic-gradient(
	  		#4e79a7 0,
  			#4e79a7 81.6%,
			  #f28e2c 0,
			  #f28e2c 100%
	  );
	  position: relative;
	  width: 500px;
	  min-height: 350px;
  	margin: 0;
  	outline: 1px solid #ccc;
  }
  .pie-chart h2 {
	  position: absolute;
	  margin: 1rem;
  }
  .pie-chart figcaption {
	  position: absolute;
	  bottom: 1em;
	  right: 1em;
  	font-size: smaller;
	  text-align: right;
  }
  .pie-chart span:after {
	  display: inline-block;
	  content: "";
	  width: 0.8em;
	  height: 0.8em;
	  margin-left: 0.4em;
	  height: 0.8em;
	  border-radius: 0.2em;
	  
  }
  </style>

</head>
<body>
    <header>
        <nav>

        </nav>
    </header>
    <main>
      <div style="display: grid;grid-template-columns: 20vw 80vw;" class="squish">
            <div style="background-color: rgb(130 72 24); height: 100vh; padding:15px; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100;">

              <div style="width: 100%; text-align: left;">
                <a href="/logout" style="font-size: 24px; color: white; text-decoration: none">Logout</a>
              </div>

                <h1 style="text-align: center;position: relative;top: 5vh;">Welcome <%= session[:uname] %>!</h1>
                <div style="position: relative; top: 25px; left: 80px; column-gap: 5px" class="column-buttons">
                  <div style="width: 100%; text-align: center;" class="column-buttons">
                    <a href = "/staff/selectproducts">
                      <button class="button">Shop</button>
                    </a>
                    <a href = "/staff/settings">
                      <button class="button">Settings</button>
                    </a>
                    <a href = "/staff/staffaccountview">
                      <button class="button">Accounts</button>
                    </a>
                    <a href = "/managestock">
                      <button class="button">Manage Stock</button>
                    </a>
                    <a href = "/orders">
                      <button class="button">View Orders</button>
                    </a>
                    <a href = "/refunds">
                      <button class="button">View Refunds</button>
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <div style="background-color: rgb(255, 255, 255); height: 100vh;" class="squish">
              <a href="/"><img src="/imgs/dashboard.png" alt="Dashboard" style="width:100%; height:100vh;"></a>
            </div>

            <div style="color: black;width: 25vw;height: 40vh;position: absolute;top: 10%;left: 30%;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;">
	            <h1>Daily Profit Analytics</h1>


            </div>

            <div style="color: black;width: 25vw;height: 40vh;position: absolute;top: 10%;left: 60%;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;">
	            <h1>Deliveries In Progress</h1>


            </div>


            <div style="color: black;width: 55vw;height: 40vh;position: absolute;top: 55%;left: 30%;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;">
              <h1>Recent Transactions</h1>
              <p>From Database Data</p>
            </div>
        </div>
    </main>
    <footer>

    </footer>
</body>