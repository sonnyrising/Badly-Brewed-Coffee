<!DOCTYPE html>
<html>
<head>
  <link href="/css/GenericTheme.css" rel="stylesheet">
  <title>Badly Brewed Coffee</title>
  <style>
      .button {
          background-color: rgb(130 72 24);
          border: none;
          color: white;
          padding: 10px 20px;
          text-align: center;
          text-decoration: none;
          display: inline-block;
          font: 16pt Helvetica, bold;
          white-space: nowrap;
          cursor: pointer;
      }

      .column-buttons {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 50px;
          margin-top: 50px;
      }

      .glass-card {
          position: absolute;
          background: transparent;
          backdrop-filter: blur(15px);
          box-shadow: 0px 0px 20px 0px #0000007a;
          border-radius: 30px;
          text-align: center;
          color: black;
          z-index: 10;
          padding: 20px;
          box-sizing: border-box;
          overflow-y: auto;
      }
  </style>
</head>

<body>
<main>
  <div style="display: grid; grid-template-columns: 20vw 80vw;" class="squish">

    <div class="squish" style="; background-color: rgb(130 72 24); height: 100vh; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100; min-width: 220px;">

      <div style="width: 100%; text-align: left;">
        <a href="/logout"><img src="/imgs/home.png" alt="Home" style="width:30px; height:30px;"></a>
      </div>
      <div style="position: relative; top: 25px; left: 80px;" class="column-buttons">
        <form action="/staff/homepage" method="get">
          <button class="button">Home</button>
        </form>
        <form action="/staff/selectproducts" method="post">
          <button class="button">Shop</button>
        </form>
        <form action="/staff/settings" method="post">
          <button class="button">Settings</button>
        </form>
        <form action="/staff/staffaccountview" method="post">
          <button class="button">Accounts</button>
        </form>
        <form action="/staff/managestock" method="post">
          <button class="button">Stock</button>
        </form>
        <form action="/" method="post">
          <button class="button">Log Out</button>
        </form>
      </div>
    </div>

    <div style="background-color: rgb(255, 255, 255); height: 100vh; position: relative; overflow: hidden; min-width: 800px;" class="squish";>

      <img src="/imgs/dashboard.png" alt="Dashboard" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;">

      <div class="container">
        <div class="glass-card" style="top: 3%; left: 3%; width: 93%; height: 93%;">
          <h1>Orders:</h1>
          <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <thead>
            <tr>
              <th>Order ID</th>
              <th>Total Price</th>
              <th>Date Ordered</th>
              <th>Status</th>
            </tr>
            </thead>
            <tbody>
            <% @orders.each do |order| %>
              <tr>
                <td><%= order.TransactionId %></td>
                <td>£<%= order.Quantity %></td>
                <td><%= format_date(order.TransactionDate) %></td>
                <td>
                  <form action="/manager/orders/updatestatus" method="POST">
                    <input type="hidden" name="transaction_id" value="<%= order.TransactionId %>">
                    <select name="status" onchange="this.form.submit()">
                      <option value="Pending"    <%= 'selected' if order.Status == 'Pending'    %>>Pending</option>
                      <option value="Processing" <%= 'selected' if order.Status == 'Processing' %>>Processing</option>
                      <option value="Completed"  <%= 'selected' if order.Status == 'Completed'  %>>Completed</option>
                      <option value="Cancelled"  <%= 'selected' if order.Status == 'Cancelled'  %>>Cancelled</option>
                    </select>
                  </form>
                </td>
              </tr>
            <% end %>
            </tbody>/
          </table>
        </div>
      </div>
    </div>
  </div>
</main>
</body>
</html>