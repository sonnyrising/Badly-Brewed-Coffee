<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <link href="/css/LoginPageTheme.css" rel="stylesheet">
    <title>Forgot Password</title>
</head>
<body>
    <header>
        
    </header>
    <main>
        <div style="display: grid; grid-template-columns: 1fr 2fr;" class="squish">
            <div style="background-color: rgb(130 72 24); height: 100vh; padding: 15px;box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100;">
              <a href="/"><img src="/imgs/home.png" alt="Home" style="width:30px; height:30px;"></a>
              <a href="/user/homepage"><img src="/imgs/ShoppingCart.png" alt="Home" style="width:30px; height:30px;"></a>
                <h1 style="text-align: center;position: relative;top: 5vh;">Forgot Password</h1>
                <form action="/landingpage" method="post">
                    <input type="text" id="username" name="uname" placeholder="Username" required style="width: 25vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;position: relative;left: 50%;top: 20vh;transform: translateX(-50%);">
                    <br>
                    <button type="submit" style="position: relative;top: 23vh;left: 50%;transform: translateX(-50%);width: 7vw;height: 5vh;border: 2px solid #69312b;border-radius: 7px;">Request A Password Reset</button>
                </form>
                <p style="position: absolute;top: 60vh;left: 16%;transform: translateX(-50%);">Password Resets can take 3-5 working days. Sign in as guest <a href="/user/homepage" style="color:white;">here</a>.</p>
                <p style="position: absolute;top: 90vh;left: 16%;transform: translateX(-50%);">Don't have an account? Sign up <a href="/register" style="color:white;">here</a>.</p>
            </div>
            <div style="background-color: rgb(255, 255, 255); height: 100vh;">
                <img src="/imgs/CoffeeBeansSplash.png" alt="Whoops, we slipped up!" style="width:100%; height:100%; object-fit: cover;">
                <div style="color: black;width: 51vw;height: 83vh;position: absolute;top: 50%;left: 66.6%;transform: translate(-50%, -50%);background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;">
                    <h1>New deals</h1>
                    <p>This is where new deals will go.</p>
                </div>
            </div>
        </div>
    </main>
    <footer>

    </footer>
</body>