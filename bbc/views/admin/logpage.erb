<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Logging</title>
    <style>
      * body{
        overflow:visible;
      }
      table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;
      }

      td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
      }

      tr:nth-child(even) {
        background-color: #dddddd;
      } 
    </style>

</head>
<body>
    <header>
        <nav>
        <h1 style="color:black;float: left;margin-left: 1vw;;">Activity Log</h1>
        <ul style="position:absolute; top:1vh;">
            <li><a href="/admin/homepage" class="smooth-link">Dashboard</a></li>
            <li><a href="/admin/views" class="smooth-link">Views</a></li>
            <li><a href="/admin/orders" class="smooth-link">Orders</a></li>
            <li><a href="/admin/accounts" class="smooth-link">Accounts</a></li>
            <li><a href="/admin/feedback" class="smooth-link">Feedback</a></li>
            <li><a href="/admin/log" class="smooth-link">Logs</a></li>
            <li><a href="/" class="smooth-link">Log out</a></li>
        </ul>
        </nav>
    </header>
    <main>
      <div style="background-color: rgb(130 72 24); height: 100vh;">
        <img src="/imgs/dashboard.png" alt="Dashboard" style="width: 100%;height: 100%;object-fit: fill;">

        <div style="display: flex;flex-direction: row;flex-wrap:nowrap;justify-content: center;gap: 32px;height: 85vh;position: absolute;top: 10vh;left:50vw;transform:translateX(-50%);">
          <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;width:94vw; overflow-y: scroll;">
            <h1>Logs:</h1>
            <div style="position:relative;top:3vh;">
                <table style="table-layout: fixed; border-collapse: collapse;">
                    <tr><td>Author</td><td>Date</td><td>Description</td></tr>
                    <% @shown_logs.each do |log| %>
                        <tr>
                            <td><%= Users[log.UserId].Username %></td>
                            <td><%= log.LogDate %></td>
                            <td><%= log.LogDescription %></td>
                        </tr>
                    <% end %>
                </table>
            </div>
          </div>
        </div>
      </div>
    </main>
    <footer>

    </footer>
</body>