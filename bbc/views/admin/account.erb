<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Accounts</title>
    <style>
      * body{
        overflow:visible;
      }
    </style>

</head>
<body>
    <header>
      <nav>
        <h1 style="color:black;float: left;margin-left: 1vw;">Accounts</h1>
        <ul style="position:absolute; top:1vh;">
            <li><a href="/admin" class="smooth-link">Dashboard</a></li>
            <li><a href="/admin/views" class="smooth-link">Views</a></li>
            <li><a href="/admin" class="smooth-link">Orders</a></li>
            <li><a href="/admin/accounts" class="smooth-link">Accounts</a></li>
            <li><a href="/admin/feedback" class="smooth-link">Feedback</a></li>
            <li><a href="/user/settings" class="smooth-link">Settings</a></li>
            <li><a href="/" class="smooth-link">Log out</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <div style="background-color: rgb(130 72 24); height: 100vh;">
        <img src="/imgs/dashboard.png" alt="Dashboard" style="width: 100%;height: 100%;object-fit: fill;">

        <div style="position: absolute;top: 10vh;left:50vw;transform:translateX(-50%);">
          <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;width:94vw;align-items: center;">
            <h1><%= @account.Username %></h1>
            <div style="display: grid;grid-template-columns: 100%;gap: 1vh;text-align: left;padding: 5vh 0;" >
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; padding-left: 10vw;">Account ID:</b>
                <%= @account.UserId %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; padding-left: 10vw;">Account username:</b>
                <%= @account.Username %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; padding-left: 10vw;">Account email:</b>
                <%= @account.Email %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; padding-left: 10vw;">Loyalty points:</b>
                <%= @account.LoyaltyPoints %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; padding-left: 10vw;">Shipping address:</b>
                <%= @account.Email %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; padding-left: 10vw;">Order quantity:</b>
                <%= @account.Email %>
              </div>
              <div style="display: grid; grid-template-columns: 2fr 1fr;">
                <b style="position:relative; padding-left: 10vw;">Inactivity period:</b>
                <%= @account.DaysSinceLastUse %>
              </div>
            </div>

            <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 10px;text-align: center;width:80vw;margin: 0 auto;">
              <h1>Transaction history:</h1>
              <% Transactions.where(UserId: @account.UserId).each do |order| %>
                <div style="display: flex;flex-direction: row;flex-wrap: wrap;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius:30px;width: 90%;margin: 0 auto;overflow-y:auto;">
                  <style>
                    .delete-button:hover{
                      background-color: rgb(255, 94, 94);
                    }
                  </style>
                  <div style="display: flex; flex-direction: row; justify-content: space-evenly; width: 50%;">
                    <h3 style="margin-left: 10%;"><%= order.TransactionId %></h3>
                    <b><%= Users[order.UserId].Username %></b>
                    <b>£<%= order.TotalCost %></b>
                    <b>
                      <%= order.TransactionDate.to_s.length > 5 ?
                            order.TransactionDate.to_s.insert(2, "/").insert(5, "/") :
                            order.TransactionDate %>
                    </b>
                  </div>
                  
                  <div style="display: grid; grid-template-columns: 3vw 3vw 5vw 3vw;position:absolute; right:5%">
                    <form method="post" action="/admin/orders/edit">
                      <button type="submit" class="edit-button">Edit</button>
                      <input type="hidden" name="transaction-id" value="<%= order.TransactionId %>">
                    </form>
                    <form method="post" action="/admin/orders/delete">
                      <button type="submit" class="delete-button">Delete</button>
                      <input type="hidden" name="transaction-id" value="<%= order.TransactionId %>">
                    </form>
                  </div>
                </div>
                <br>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </main>
    <footer>

    </footer>
</body>