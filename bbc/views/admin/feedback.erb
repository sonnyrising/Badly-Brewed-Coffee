<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Feedback</title>
    <style>
      * body{
        overflow:visible;
      }
      table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;
      }

      td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
      }

      tr:nth-child(even) {
        background-color: #dddddd;
      } 
    </style>

</head>
<body>
    <header>
        <nav>
        <h1 style="color:black;float: left;margin-left: 1vw;;">Feedback</h1>
        <ul style="position:absolute; top:1vh;">
            <li><a href="/admin" class="smooth-link">Dashboard</a></li>
            <li><a href="/admin/views" class="smooth-link">Views</a></li>
            <li><a href="/admin/orders" class="smooth-link">Orders</a></li>
            <li><a href="/admin/accounts" class="smooth-link">Accounts</a></li>
            <li><a href="/admin/feedback" class="smooth-link">Feedback</a></li>
            <li><a href="/user/settings" class="smooth-link">Settings</a></li>
            <li><a href="/" class="smooth-link">Log out</a></li>
        </ul>
        </nav>
    </header>
    <main>
      <div style="background-color: rgb(130 72 24); height: 100vh;">
        <img src="/imgs/dashboard.png" alt="Dashboard" style="width: 100%;height: 100%;object-fit: fill;">

        <div style="display: flex;flex-direction: row;flex-wrap:nowrap;justify-content: center;gap: 32px;height: 85vh;position: absolute;top: 10vh;left:50vw;transform:translateX(-50%);">
          <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;width:94vw;">
            <h1>Feedback listing:</h1>
            <form method="get" action="/admin/feedback" style="display:inline-block; position:relative; top:-4%; left:30vw;">
              <div style="display: flex; flex-direction: row; align-items: center; gap: 1vw;">
                <form action="/manager/viewfeedback" method="get">
                  <input type="radio" style="border-spacing: 10px" id="issues" name="filter" value="general_issue" <%= 'checked' if params['filter'] != 'refund' %>>
                  <label for="issues" style="white-space: nowrap; font-size: 18px">General Issues</label>

                  <input type="radio" id="refund" name="filter" value="refund" <%= 'checked' if params['filter'] == 'refund' %>>
                  <label for="refund" style="white-space: nowrap; font-size: 18px">Refunds Only</label>

                  <input style="border-radius: 8px; font-size: 18px; border-spacing: 5px" type="submit" value="Filter">
                </form>
              </div>
            </form>
            <div style="position:relative;top:3vh;">
              <% @shown_feedback.each do |feedback| %>
                <div style="display: flex;flex-direction: row;flex-wrap: wrap;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius:30px;width:94vw;overflow-y:auto;">
                  <style>
                    .delete-button:hover{
                      background-color: rgb(255, 94, 94);
                    }
                  </style>
                  <h3 style="margin-left: 10%;"><%= feedback.FeedbackId %></h3>
                  <% if feedback.RefundRequest == "Yes" %>
                    <p style="padding-left: 2vw;">Ticket : <%= feedback.TicketNumber %></p>
                    <p style="padding-left: 2vw;">Reason : <%= feedback.RefundReason %></p>
                  <% else  %>
                    <p style="padding-left: 2vw;"><%= feedback.IssueContent %></p>
                  <% end %>
                
                  <div style="display: grid; grid-template-columns: 3vw 3vw 5vw 3vw;position:absolute; right:5%">
                    <form method="post" action="/admin/feedback/delete">
                      <button type="submit" class="delete-button">Delete</button>
                      <input type="hidden" name="feedbackId" value="<%= feedback.FeedbackId %>">
                    </form>
                  </div>
                </div>
                <br>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </main>
    <footer>

    </footer>
</body>