<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Dashboard</title>
    <style>
      * body{
        overflow:visible;
      }
    </style>

</head>
<body>
    <header>
      <nav>
        <h1 style="color:black;float: left;margin-left: 1vw;;">Overview</h1>
        <ul style="position:absolute; top:1vh;">
          <li><a href="/admin" class="smooth-link">Dashboard</a></li>
          <li><a href="/admin" class="smooth-link">Orders</a></li>
          <li><a href="/admin/accounts" class="smooth-link">Accounts</a></li>
          <li><a href="/admin/feedback" class="smooth-link">Feedback</a></li>
          <li><a href="/user/settings" class="smooth-link">Settings</a></li>
          <li><a href="/" class="smooth-link">Log out</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <div style="background-color: rgb(130 72 24); height: 100vh;">
        <img src="/imgs/dashboard.png" alt="Dashboard" style="width: 100%;height: 100%;object-fit: fill;">

        <div style="display: flex;flex-direction: row;flex-wrap: wrap;justify-content: center;gap: 32px;height: 85vh;position: absolute;top: 10vh;">
          <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;width:22vw;">
            <h1>Website traffic</h1>
            <p>Current login count:</p>
            <%= @currentVisitCount %>
          </div>

          <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;width:22vw;">
            <h1>Staff logins</h1>
            <p>This is where the total number of staff logins should go.</p>
          </div>

          <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;width:22vw;">
            <h1>Feedback quantity</h1>
            <p>From Database Data</p>
          </div>

          <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;width:22vw;">
            <h1>Unresolved orders</h1>
            <p>From Database Data</p>
          </div>

          <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;width:46vw;">
            <h1>Transaction log</h1>
            <p>From Database Data</p>
          </div>

          <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;width:46vw;">
            <h1>Another data frame</h1>
            <p>From Database Data</p>
          </div>
        </div>
      </div>
    </main>
    <footer>

    </footer>
</body>