<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Edit accounts</title>
    <style>
      * body{
        overflow:visible;
      }
    </style>

</head>
<body>
    <header>
      <nav>
        <h1 style="color:black;float: left;margin-left: 1vw;">Accounts</h1>
        <ul style="position:absolute; top:1vh;">
            <li><a href="/admin/homepage" class="smooth-link">Dashboard</a></li>
            <li><a href="/admin/views" class="smooth-link">Views</a></li>
            <li><a href="/admin/orders" class="smooth-link">Orders</a></li>
            <li><a href="/admin/accounts" class="smooth-link">Accounts</a></li>
            <li><a href="/admin/feedback" class="smooth-link">Feedback</a></li>
            <li><a href="/admin/log" class="smooth-link">Logs</a></li>
            <li><a href="/" class="smooth-link">Log out</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <div style="background-color: rgb(130 72 24); height: 100vh;">
        <img src="/imgs/dashboard.png" alt="Dashboard" style="width: 100%;height: 100%;object-fit: fill;">

        <div style="position: absolute;top: 10vh;left:50vw;transform:translateX(-50%);">
          <div style="color: black;background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px;text-align: center;width:94vw;align-items: center;height: max-content;">
            <h1><%= @account.Username %></h1>
            <form method="post" action="/admin/accounts/edit/update">
              <div style="display: grid;grid-template-columns: 100%;gap: 1vh;text-align: left;" >
                <div style="display: grid; grid-template-columns: 2fr 1fr;">
                    <b style="position:relative; padding-left: 10vw;">Account ID:</b>
                    <%= @account.UserId %>
                </div>
                <div style="display: grid; grid-template-columns: 2fr 1fr;">
                    <b style="position:relative; padding-left: 10vw;">Account username:</b>
                    <input type="text" name="username-data" value=<%= @account.Username %>>
                </div>
                <div style="display: grid; grid-template-columns: 2fr 1fr;">
                    <b style="position:relative; padding-left: 10vw;">Account email:</b>
                    <input type="text" name="email-data" value=<%= @account.Email %>>
                </div>
                <div style="display: grid; grid-template-columns: 2fr 1fr;">
                    <b style="position:relative; padding-left: 10vw;">Loyalty points:</b>
                    <input type="text" name="loyaltypoint-data" value=<%= @account.LoyaltyPoints %>>
                </div>
                <div style="display: grid; grid-template-columns: 2fr 1fr;">
                    <b style="position:relative; padding-left: 10vw;">Shipping address:</b>
                    <input type="text" name="address-data" value=<%= @account.Email %>>
                </div>
                <div style="display: grid; grid-template-columns: 2fr 1fr;">
                    <b style="position:relative; padding-left: 10vw;">Order quantity:</b>
                    <%= @account.Email %>
                </div>
                <div style="display: grid; grid-template-columns: 2fr 1fr;">
                    <b style="position:relative; padding-left: 10vw;">Inactivity period:</b>
                    <input type="text" name="inactivity-data" value=<%= @account.DaysSinceLastUse %>>
                </div>

                <input type="hidden" name="account-data" value="<%= @account.UserId %>">
              </div>
              <button type="submit" style="width:5vw;height:3vh;">Save</button>
            </form>
            <form method="post" action="/admin/accounts/edit/recover" style="padding:5vh;">
              <input type="hidden" name="account-data" value="<%= @account.UserId %>">
              <button type="submit">Reset password</button>
            </form>
          </div>
        </div>
      </div>
    </main>
    <footer>

    </footer>
</body>