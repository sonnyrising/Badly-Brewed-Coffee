<!DOCTYPE html>
<html>
<head>
  <link href="/css/GenericTheme.css" rel="stylesheet">
  <title>Badly Brewed Coffee</title>
  <style>
      .glass-card {
          position: absolute;
          background: transparent;
          backdrop-filter: blur(15px);
          box-shadow: 0px 0px 20px 0px #0000007a;
          border-radius: 30px;
          text-align: center;
          color: black;
          z-index: 10;
          padding: 20px;
          box-sizing: border-box;
          overflow-y: auto;
      }

      .glass-card table th,
      .glass-card table td {
          padding: 18px 10px;
          text-align: center;
          border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      }

      .confirm-overlay {
          display: none;
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: rgba(0, 0, 0, 0.2);
          z-index: 10000;
          align-items: center;
          justify-content: center;
      }

      .confirm-box {
          background: rgba(255, 255, 255, 0.7);
          backdrop-filter: blur(15px);
          box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.2);
          border-radius: 30px;
          padding: 30px 40px;
          color: black;
          max-width: 400px;
          border: 1px solid rgba(255, 255, 255, 0.3);
      }

      .confirm-message {
          margin: 0 0 20px;
      }

      .confirm-actions {
          display: flex;
          gap: 12px;
          justify-content: center;
      }

      .btn {
          height: 80%;
          color: white;
          padding: 4px 8px;
          border-radius: 8px;
          border: none;
          cursor: pointer;
          font-size: 9pt;
          font-weight: bold;
          text-decoration: none;
      }

      .btn-green { background: rgba(50, 160, 80, 0.85); }
      .btn-red   { background: rgba(200, 50, 50, 0.85); }
      .btn-grey  { background: rgba(100, 100, 100, 0.7); }
  </style>
</head>

<body>
<main>
  <div id="confirm-dialogue" class="confirm-overlay">
    <div class="confirm-box">
      <p id="confirm-message" class="confirm-message"></p>
      <div class="confirm-actions">
        <a id="confirm-yes" href="#" class="btn"></a>
        <button class="btn btn-grey" onclick="closeConfirm()">Cancel</button>
      </div>
    </div>
  </div>

  <div style="background-color: rgb(255, 255, 255); height: 100vh; position: relative; overflow: hidden; min-width: 800px;" class="squish";>
    <img src="/imgs/dashboard.png" alt="Dashboard" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;">
    <div class="container">
      <div class="glass-card" style="top: 3%; left: 3%; width: 93%; height: 93%;">
        <a href="/manager/refunds" class="btn btn-grey" style="padding: 12px 24px; font-size: 14pt; height: auto;">
          <span style="font-weight: bold;">Back</span>
        </a>

        <div style="display: grid; place-items: center; margin: 0; min-height: 80vh;">
          <div>
            <h1 style="font-size: 20pt">Refund Information:</h1>

            <div style="font-size: 12pt">
              <p>Transaction ID: <%= @refund_info[:transaction_id] %></p>
              <p>Amount: £<%= @refund_info[:total_cost] %></p>
              <p>Reason: <%= @refund_info[:refund_reason] %></p>
              <p>Date Ordered: <%= @refund_info[:transaction_date] %></p>
              <p>Status: <%= @refund_info[:status] %></p>
            </div>

            <div style="display: flex; gap: 3px; justify-content: center;">
              <button class="btn btn-green" onclick="showConfirm('/manager/refunds?message=accept&refund_id=<%= @refund_info[:transaction_id] %>', 'accept')">
                Accept
              </button>
              <button class="btn btn-red" onclick="showConfirm('/manager/refunds?message=decline&refund_id=<%= @refund_info[:transaction_id] %>', 'decline')">
                Decline
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>



  <script>
      const confirmConfig = {
          accept:  { message: 'Are you sure you want to accept this refund?',  label: 'Yes, Accept',  colour: 'btn-green' },
          decline: { message: 'Are you sure you want to decline this refund?', label: 'Yes, Decline', colour: 'btn-red'   }
      };

      function showConfirm(url, type) {
          const config = confirmConfig[type];
          const confirmYes = document.getElementById('confirm-yes');
          confirmYes.href = url;
          confirmYes.textContent = config.label;
          confirmYes.className = 'btn ' + config.colour;
          document.getElementById('confirm-message').textContent = config.message;
          document.getElementById('confirm-dialogue').style.display = 'flex';
      }

      function closeConfirm() {
          document.getElementById('confirm-dialogue').style.display = 'none';
      }
  </script>
</main>
</body>
</html>