<!DOCTYPE html>
<html>
<head>
  <link href="/css/GenericTheme.css" rel="stylesheet">
  <title>Badly Brewed Coffee</title>
  <style>
      .glass-card {
          position: absolute;
          background: transparent;
          backdrop-filter: blur(15px);
          box-shadow: 0px 0px 20px 0px #0000007a;
          border-radius: 30px;
          text-align: center;
          color: black;
          z-index: 10;
          padding: 20px;
          box-sizing: border-box;
          overflow-y: auto;
      }
  </style>
</head>

<body>
<main>
  <div style="display: grid; grid-template-columns: 20vw 80vw;" class="squish">
    <div style="background-color: rgb(255, 255, 255); height: 100vh; position: relative; overflow: hidden; min-width: 800px;" class="squish";>
      <img src="/imgs/dashboard.png" alt="Dashboard" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;">
      <div class="container">
        <div class="glass-card" style="top: 3%; left: 3%; width: 93%; height: 93%;">
          <h1>Refund Information:</h1>
          <div style="display: flex; gap: 3px; justify-content: center;">
            <button class="btn btn-green" onclick="showConfirm('/manager/refunds?message=accept&refund_id=<%= order.TransactionId %>', 'accept')">
              Accept
            </button>
            <button class="btn btn-red" onclick="showConfirm('/manager/refunds?message=decline&refund_id=<%= order.TransactionId %>', 'decline')">
              Decline
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>



  <script>
      const confirmConfig = {
          accept:  { message: 'Are you sure you want to accept this refund?',  label: 'Yes, Accept',  colour: 'btn-green' },
          decline: { message: 'Are you sure you want to decline this refund?', label: 'Yes, Decline', colour: 'btn-red'   }
      };

      function showConfirm(url, type) {
          const config = confirmConfig[type];
          const confirmYes = document.getElementById('confirm-yes');
          confirmYes.href = url;
          confirmYes.textContent = config.label;
          confirmYes.className = 'btn ' + config.colour;
          document.getElementById('confirm-message').textContent = config.message;
          document.getElementById('confirm-dialogue').style.display = 'flex';
      }

      function closeConfirm() {
          document.getElementById('confirm-dialogue').style.display = 'none';
      }
  </script>

  <% if @alert_message %>
    <%
      is_success = @alert_message.downcase.include?('accepted')
      alert_class = is_success ? 'btn-green' : 'btn-red'
      if is_success
        @payment_message = "The Payment Provider has been notified of the refund."
        @email_message = "The user has been emailed a receipt for the refund."
      end
    %>

    <div id="alert-banner" class="alert-banner <%= alert_class %>">
      <span><%= @alert_message %></span>
      <span><%=  @payment_message %></span>
      <span><%=  @email_message %></span>
      <span class="alert-close" onclick="document.getElementById('alert-banner').remove()">✕</span>
    </div>

    <script>
        setTimeout(() => {
            const banner = document.getElementById('alert-banner');
            if (banner) banner.remove();
        }, 10000);
    </script>
  <% end %>
</main>
</body>
</html>