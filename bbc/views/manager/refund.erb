<!DOCTYPE html>
<html>
<head>
  <link href="/css/GenericTheme.css" rel="stylesheet">
  <title>Badly Brewed Coffee</title>
  <style>
      .button {
          background-color: rgb(130 72 24);
          border: none;
          color: white;
          padding: 10px 20px;
          text-align: center;
          text-decoration: none;
          display: inline-block;
          font: 16pt Helvetica, bold;
          white-space: nowrap;
          cursor: pointer;
      }

      .column-buttons {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 50px;
          margin-top: 50px;
      }

      .glass-card {
          position: absolute;
          background: transparent;
          backdrop-filter: blur(15px);
          box-shadow: 0px 0px 20px 0px #0000007a;
          border-radius: 30px;
          text-align: center;
          color: black;
          z-index: 10;
          padding: 20px;
          box-sizing: border-box;
          overflow-y: auto;
      }

      .product-box {
          color: black;
          background: rgba(255, 255, 255, 0.2);
          backdrop-filter: blur(15px);
          box-shadow: 0px 0px 20px 0px #0000007a;
          border-radius: 20px;
          text-align: center;
          padding: 10px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          transition: transform 0.3s ease;
      }

      .product-box:hover {
          transform: scale(1.02);
      }

      .product-inner-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          grid-template-rows: repeat(2, 1fr);
          gap: 20px;
          width: 90%;
          height: 90%;
          margin: 5% auto;
      }

      .product-image {
          width: 100px;
          height: 100px;
          object-fit: cover;
          border-radius: 15px;
          margin-bottom: 15px;
      }

      .inline-input {
          border: none;
          background: transparent;
          padding: 0 2px;
          margin: 0 2px;
          font: inherit;
          color: inherit;
          border-bottom: 1px dashed #999;
          cursor: text;
          width: 90%;
          max-width: 180px;
          text-align: center;
      }

      .product-box p, .product-box h3 {
          margin: 2px 0;
          font-size: 0.9em;
      }

      .product-box form {
          width: 100%;
      }


  </style>
</head>

<body>
<main>
  <div style="display: grid; grid-template-columns: 20vw 80vw;" class="squish">

    <div class="squish" style="background-color: rgb(130 72 24); height: 100vh; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100; min-width: 220px;">

      <div style="width: 100%; text-align: left;">
        <a href="/logout"><img src="/imgs/home.png" alt="Home" style="width:30px; height:30px;"></a>
      </div>

      <h1 style="text-align: center; margin-top: 2vh;">Welcome Back Kenny!</h1>
      <h4 style="color: lightgray; margin-top: 10px; text-align: center;">What would you like to do today?</h4>

      <div style="width: 100%; text-align: center;" class="column-buttons">
        <a href = "/manager/homepage">
          <button class="button">View Dashboard</button>
        </a>
        <a href = "/staff/homepage">
          <button class="button">Step in as Barista</button>
        </a>
        <a href = "/manager/managestock">
          <button class="button">Manage Stock</button>
        </a>
        <a href = "/manager/orders">
          <button class="button">View Orders</button>
        </a>
        <a href = "/manager/refunds">
          <button class="button">View Refunds</button>
        </a>
      </div>
    </div>

    <div style="background-color: rgb(255, 255, 255); height: 100vh; position: relative; overflow: hidden; min-width: 800px;" class="squish";>

      <img src="/imgs/dashboard.png" alt="Dashboard" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;">
      <div class="container">
        <div class="glass-card" style="top: 3%; left: 5%; width: 44%; height: 93%;">
          <h1>Pending Online Refunds</h1>
          <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <thead>
            <tr>
              <th>Order ID</th>
              <th>Total Price</th>
              <th>Date Ordered</th>
              <th>Status</th>
            </tr>
            </thead>
            <tbody>
            <% @orders.each do |order| %>
              <tr>
                <td><%= order.TransactionId %></td>
                <td>£<%= order.Quantity %></td>
                <td><%= format_date(order.TransactionDate) %></td>
                <td><%= order.Status %></td>
                <td>
                  <form action="/manager/refunds/acceptRefund<%= order.TransactionId %>" method="post">
                    <button type="submit" class="button">Accept Refund</button>
                  </form>
                  <form action="/manager/refunds/declineRefund<%= order.TransactionId %>" method="post">
                    <button type="submit" class="button">Decline Refund</button>
                  </form>
                </td>
              </tr>
            <% end %>
            </tbody>/
          </table>
        </div>
      </div>


      <div class="glass-card" style="top: 3%; left: 53%; width: 44%; height: 93%; text-align: left;">
        <h1>In-Store Refunds</h1>
        <p>Enter UserID</p>
      </div>
    </div>
  </div>

  <% if @alert_message %>
    <div id="alert-banner" style="
    position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(200, 50, 50, 0.85);
      backdrop-filter: blur(15px);
      color: white;
      padding: 16px 40px 16px 20px;
      border-radius: 12px;
      box-shadow: 0px 4px 20px rgba(0,0,0,0.3);
      font-family: Helvetica, sans-serif;
      font-size: 13pt;
      z-index: 9999;
      max-width: 600px;
      text-align: center;
    ">
      ⚠️ <%= @alert_message %>
      <span onclick="document.getElementById('alert-banner').remove()" style="
      position: absolute;
        top: 8px;
        right: 14px;
        cursor: pointer;
        font-size: 16pt;
        line-height: 1;
      ">✕</span>
    </div>

    <script>
        setTimeout(() => {
            const banner = document.getElementById('alert-banner');
            if (banner) banner.remove();
        }, 5000);
    </script>
  <% end %>

</main>
</body>
</html>