<!DOCTYPE html>
<html>
<head>
  <link href="/css/GenericTheme.css" rel="stylesheet">
  <title>Badly Brewed Coffee</title>
  <style>
      .button {
          background-color: rgb(130 72 24);
          border: none;
          color: white;
          padding: 10px 20px;
          text-align: center;
          text-decoration: none;
          display: inline-block;
          font: 16pt Helvetica, bold;
          white-space: nowrap;
          cursor: pointer;
      }

      .column-buttons {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 50px;
          margin-top: 50px;
      }

      .glass-card {
          position: absolute;
          background: transparent;
          backdrop-filter: blur(15px);
          box-shadow: 0px 0px 20px 0px #0000007a;
          border-radius: 30px;
          text-align: center;
          color: black;
          z-index: 10;
          padding: 20px;
          box-sizing: border-box;
          overflow-y: auto;
      }

      .inline-input {
          border: none;
          background: transparent;
          padding: 0 2px;
          margin: 0 2px;
          font: inherit;
          color: inherit;
          border-bottom: 1px dashed #999;
          cursor: text;
          width: 90%;
          max-width: 180px;
          text-align: center;
      }

      .alert-banner {
          position: fixed;
          top: 20px;
          left: 50%;
          transform: translateX(-50%);
          background: rgba(200, 50, 50, 0.85);
          backdrop-filter: blur(15px);
          -webkit-backdrop-filter: blur(15px); /* Safari support */
          color: white;
          padding: 16px 40px 16px 20px;
          border-radius: 12px;
          box-shadow: 0px 4px 20px rgba(0,0,0,0.3);
          font-family: Helvetica, sans-serif;
          font-size: 13pt;
          z-index: 9999;
          max-width: 600px;
          text-align: center;
          transition: opacity 0.4s ease; /* Enables the smooth fade out */
      }

      .alert-close-btn {
          position: absolute;
          top: 8px;
          right: 14px;
          background: none;
          border: none;
          color: white;
          cursor: pointer;
          font-size: 16pt;
          line-height: 1;
          padding: 0;
      }
  </style>
</head>

<body>
<main>
  <div style="display: grid; grid-template-columns: 20vw 80vw;" class="squish">

    <div class="squish" style="; background-color: rgb(130 72 24); height: 100vh; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100; min-width: 220px;">

      <div style="width: 100%; text-align: left;">
        <a href="/logout" style="font-size: 24px; color: white; text-decoration: none">Logout</a>
      </div>

      <h1 style="text-align: center; margin-top: 2vh;">Welcome Back Kenny!</h1>
      <h4 style="color: lightgray; margin-top: 10px; text-align: center;">What would you like to do today?</h4>

      <div style="width: 100%; text-align: center;" class="column-buttons">
        <a href = "/manager/homepage">
          <button class="button">View Dashboard</button>
        </a>
        <a href = "/staff/homepage">
          <button class="button">Step in as Barista</button>
        </a>
        <a href = "/manager/managestock">
          <button class="button">Manage Stock</button>
        </a>
        <a href = "/manager/orders">
          <button class="button">View Orders</button>
        </a>
        <a href = "/manager/refunds">
          <button class="button">View Refunds</button>
        </a>
      </div>
    </div>

    <div style="background-color: rgb(255, 255, 255); height: 100vh; position: relative; overflow: hidden; min-width: 800px;" class="squish";>

      <img src="/imgs/dashboard.png" alt="Dashboard" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;">

      <nav style="position: absolute; top: 0; left: 0; width: 100%; height: 70px; display: flex; align-items: center; justify-content: flex-end; padding: 0 40px; box-sizing: border-box; z-index: 20; background: transparent; backdrop-filter: blur(15px); box-shadow: 0px 5px 15px 0px #00000030;">
        <a href="/manager/homepage" style="color: black; text-decoration: none; font-family: Helvetica, sans-serif; font-weight: bold; font-size: 14pt;">Dashboard</a>
        <a href="/manager/salesmetrics" style="color: black; text-decoration: none; margin-left: 30px; font-family: Helvetica, sans-serif; font-weight: bold; font-size: 14pt;">Sales Metrics</a>
        <a href="/manager/adjustloyalty" style="color: black; text-decoration: none; margin-left: 30px; font-family: Helvetica, sans-serif; font-weight: bold; font-size: 14pt;">Adjust Loyalty</a>
        <a href="/manager/viewfeedback" style="color: black; text-decoration: none; margin-left: 30px; font-family: Helvetica, sans-serif; font-weight: bold; font-size: 14pt;">View Feedback</a>
      </nav>

      <div class="container">
        <div class="glass-card" style="top: 15%; left: 5%; width: 85%; height: 80%;">
          <h1>Customer Feedback</h1>
          <h2>Feedback and reviews left by customers</h2>
          <div style="display: flex; justify-content: center; align-items: center; margin-top: 5px;">
            <form action="/manager/viewfeedback" method="get">
              <input type="radio" style="border-spacing: 10px" id="issues" name="filter" value="general_issue" <%= 'checked' if params['filter'] != 'refund' %>>
              <label for="issues" style="white-space: nowrap; font-size: 18px">General Issues</label>

              <input type="radio" id="refund" name="filter" value="refund" <%= 'checked' if params['filter'] == 'refund' %>>
              <label for="refund" style="white-space: nowrap; font-size: 18px">Refunds Only</label>

              <input style="border-radius: 8px; font-size: 18px; border-spacing: 5px" type="submit" value="Filter">
            </form>
          </div>
          <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <thead>
            <tr>
              <th>Ticket Number</th>
              <th>User ID</th>
              <th>Username</th>
              <th>Date ordered</th>
              <th>Refund Requested</th>
              <th>Feedback</th>
            </tr>
            </thead>
            <tbody>
            <% if @shown_feedback.nil? || @shown_feedback.empty? %>
              <tr>
                <td colspan="7">No Feedback.</td>
              </tr>
            <% else %>
              <% @shown_feedback.each do |feedback| %>
                <tr>
                  <td><%= feedback.TicketNumber %></td>
                  <td><%= feedback.UserId %></td>
                  <td><%= Users.where(UserId: feedback.UserId).first.Username %></td>
                  <td><%= format_date(Transactions.where(TransactionId: feedback.TransactionId).first.TransactionDate) %></td>
                    <% if feedback.RefundRequest %>
                      <td>Yes</td>
                    <% else %>
                      <td>No</td>
                    <% end %>
                  <td><%= feedback.IssueContent %></td>
                </tr>
              <% end %>
            <% end %>
            </tbody>
          </table>

        </div>
      </div>
    </div>
  </div>

</main>
</body>
</html>