<!DOCTYPE html>
<html>
<head>
  <link href="/css/GenericTheme.css" rel="stylesheet">
  <title>Badly Brewed Coffee</title>
  <style>
      .button {
          background-color: rgb(130 72 24);
          border: none;
          color: white;
          padding: 10px 20px;
          text-align: center;
          text-decoration: none;
          display: inline-block;
          font: 16pt Helvetica, bold;
          white-space: nowrap;
          cursor: pointer;
      }

      .column-buttons {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 50px;
          margin-top: 50px;
      }

      .glass-card {
          position: absolute;
          background: transparent;
          backdrop-filter: blur(15px);
          box-shadow: 0px 0px 20px 0px #0000007a;
          border-radius: 30px;
          text-align: center;
          color: black;
          z-index: 10;
          padding: 20px;
          box-sizing: border-box;
          overflow-y: auto;
      }
  </style>
</head>

<body>
<main>
  <div style="display: grid; grid-template-columns: 20vw 80vw;" class="squish">

    <div class="squish" style="; background-color: rgb(130 72 24); height: 100vh; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100; min-width: 220px;">

      <div style="width: 100%; text-align: left;">
        <a href="/logout" style="font-size: 24px; color: white; text-decoration: none">Logout</a>
      </div>

      <h1 style="text-align: center; margin-top: 2vh;">Welcome Back Kenny!</h1>
      <h4 style="color: lightgray; margin-top: 10px; text-align: center;">What would you like to do today?</h4>

      <div style="width: 100%; text-align: center;" class="column-buttons">
        <a href = "/manager/homepage">
          <button class="button">View Dashboard</button>
        </a>
        <a href = "/staff/homepage">
          <button class="button">Step in as Barista</button>
        </a>
        <a href = "/managestock">
          <button class="button">Manage Stock</button>
        </a>
        <a href = "/orders">
          <button class="button">View Orders</button>
        </a>
        <a href = "/refunds">
          <button class="button">View Refunds</button>
        </a>
      </div>
    </div>

    <div style="background-color: rgb(255, 255, 255); height: 100vh; position: relative; overflow: hidden; min-width: 800px;" class="squish";>

      <img src="/imgs/dashboard.png" alt="Dashboard" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;">

      <nav style="position: absolute; top: 0; left: 0; width: 100%; height: 70px; display: flex; align-items: center; justify-content: flex-end; padding: 0 40px; box-sizing: border-box; z-index: 20; background: transparent; backdrop-filter: blur(15px); box-shadow: 0px 5px 15px 0px #00000030;">
        <a href="/manager/salesmetrics" style="color: black; text-decoration: none; margin-left: 30px; font-family: Helvetica, sans-serif; font-weight: bold; font-size: 14pt;">Sales Metrics</a>
        <a href="/manager/topcustomers" style="color: black; text-decoration: none; margin-left: 30px; font-family: Helvetica, sans-serif; font-weight: bold; font-size: 14pt;">Top Customers</a>
        <a href="/manager/adjustloyalty" style="color: black; text-decoration: none; margin-left: 30px; font-family: Helvetica, sans-serif; font-weight: bold; font-size: 14pt;">Adjust Loyalty</a>
        <a href="/manager/viewfeedback" style="color: black; text-decoration: none; margin-left: 30px; font-family: Helvetica, sans-serif; font-weight: bold; font-size: 14pt;">View Feedback</a>
      </nav>

      <div class="container">
        <div class="glass-card" style="top: 15%; left: 5%; width: 42%; height: 35%;">
          <h1>Top Coffees</h1>
          <% @top_coffees = find_top_coffees %>
          <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <thead>
            <tr>
              <th>Rank</th>
              <th>Coffee Name</th>
              <th>Coffee Cost</th>
              <th>Total Sold</th>
            </tr>
            </thead>
            <tbody>
            <% if @top_coffees.empty? %>
              <tr>
                <td colspan="3">No Coffees.</td>
              </tr>
            <% else %>
              <% @top_coffees.each do |coffee| %>
                <tr>
                  <td><%= @top_coffees.find_index(coffee) +1 %></td>
                  <td><%= coffee.product_name %></td>
                  <td><%= coffee.price %></td>
                  <td><%= coffee.quantity_sold %></td>
                </tr>
              <% end %>
            <% end %>
            </tbody>
          </table>
        </div>


        <div class="glass-card" style="top: 15%; left: 53%; width: 42%; height: 35%;">
          <h1 style="text-align: center; margin-top: 2vh;">Free Coffees Redeemed</h1>
          <% @free_coffees = get_free_coffees_redeemed %>
          <div>
            <%= @free_coffees %>
            Coffees have been redeemed!
          </div>
        </div>

        <div class="glass-card" style="top: 55%; left: 5%; width: 42%; height: 35%;">
          <h1>Top Beans</h1>
          <% @top_beans = find_top_beans %>
          <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <thead>
            <tr>
              <th>Rank</th>
              <th>Bean Name</th>
              <th>Bean Cost</th>
              <th>Total Sold</th>
            </tr>
            </thead>
            <tbody>
            <% if @top_beans.empty? %>
              <tr>
                <td colspan="3">No Beans.</td>
              </tr>
            <% else %>
              <% @top_beans.each do |bean| %>
                <tr>
                  <td><%= @top_beans.find_index(bean) +1 %></td>
                  <td><%= bean.product_name %></td>
                  <td><%= bean.price %></td>
                  <td><%= bean.quantity_sold %></td>
                </tr>
              <% end %>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="glass-card" style="top: 55%; left: 53%; width: 42%; height: 35%;">
        <h1>Top Customers</h1>
        <% @top_beans = find_top_beans %>
        <% @top_customers = find_top_customers %>
        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
          <thead>
          <tr>
            <th>Ranking</th>
            <th>User ID</th>
            <th>Username</th>
            <th>Total Spent</th>
          </tr>
          </thead>
          <tbody>
          <% if @top_customers.empty? %>
            <tr>
              <td colspan="4">No Users.</td>
            </tr>
          <% else %>
            <% @top_customers.each do |customer| %>
              <tr>
                <td><%= @top_customers.find_index(customer) +1 %></td>
                <td><%= customer.user_id %></td>
                <td><%= customer.username %></td>
                <td><%= customer.total_spent %></td>
              </tr>
            <% end %>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>

    </div>
  </div>
</main>
</body>
</html>