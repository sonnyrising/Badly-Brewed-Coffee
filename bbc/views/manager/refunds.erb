<!DOCTYPE html>
<html>
<head>
  <link href="/css/GenericTheme.css" rel="stylesheet">
  <title>Badly Brewed Coffee</title>
  <style>
      .button {
          background-color: rgb(130 72 24);
          border: none;
          color: white;
          padding: 10px 20px;
          text-align: center;
          text-decoration: none;
          display: inline-block;
          font: 16pt Helvetica, bold;
          white-space: nowrap;
          cursor: pointer;
      }

      .column-buttons {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 50px;
          margin-top: 50px;
      }

      .glass-card {
          position: absolute;
          background: transparent;
          backdrop-filter: blur(15px);
          box-shadow: 0px 0px 20px 0px #0000007a;
          border-radius: 30px;
          text-align: center;
          color: black;
          z-index: 10;
          padding: 20px;
          box-sizing: border-box;
          overflow-y: auto;
      }

      .glass-card table th,
      .glass-card table td {
          padding: 18px 10px;
          text-align: center;
          border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      }

      .confirm-overlay {
          display: none;
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: rgba(0, 0, 0, 0.2);
          z-index: 10000;
          align-items: center;
          justify-content: center;
      }

      .confirm-box {
          background: rgba(255, 255, 255, 0.7);
          backdrop-filter: blur(15px);
          box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.2);
          border-radius: 30px;
          padding: 30px 40px;
          color: black;
          max-width: 400px;
          border: 1px solid rgba(255, 255, 255, 0.3);
      }

      .confirm-message {
          margin: 0 0 20px;
      }

      .confirm-actions {
          display: flex;
          gap: 12px;
          justify-content: center;
      }

      .btn {
          height: 80%;
          color: white;
          padding: 4px 8px;
          border-radius: 8px;
          border: none;
          cursor: pointer;
          font-size: 9pt;
          font-weight: bold;
          text-decoration: none;
      }

      .btn-green { background: rgba(50, 160, 80, 0.85); }
      .btn-red   { background: rgba(200, 50, 50, 0.85); }
      .btn-grey  { background: rgba(100, 100, 100, 0.7); }

      .alert-banner {
          position: fixed;
          top: 20px;
          left: 50%;
          transform: translateX(-50%);
          backdrop-filter: blur(15px);
          color: white;
          padding: 16px 40px 16px 20px;
          border-radius: 12px;
          box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.3);
          font-size: 13pt;
          z-index: 9999;
          max-width: 600px;
          text-align: center;
          white-space: pre-line;
      }

      .alert-close {
          position: absolute;
          top: 8px;
          right: 14px;
          cursor: pointer;
          font-size: 16pt;
          line-height: 1;
      }
  </style>
</head>

<body>
<main>

  <div id="confirm-dialogue" class="confirm-overlay">
    <div class="confirm-box">
      <p id="confirm-message" class="confirm-message"></p>
      <div class="confirm-actions">
        <a id="confirm-yes" href="#" class="btn"></a>
        <button class="btn btn-grey" onclick="closeConfirm()">Cancel</button>
      </div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 20vw 80vw;" class="squish">

    <div class="squish" style="background-color: rgb(130 72 24); height: 100vh; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100; min-width: 220px;">
      <div style="width: 100%; text-align: left;">
        <a href="/logout"><img src="/imgs/home.png" alt="Home" style="width:30px; height:30px;"></a>
      </div>
      <h1 style="text-align: center; margin-top: 2vh;">Welcome Back Kenny!</h1>
      <h4 style="color: lightgray; margin-top: 10px; text-align: center;">What would you like to do today?</h4>
      <div style="width: 100%; text-align: center;" class="column-buttons">
        <a href="/manager/homepage"><button class="button">View Dashboard</button></a>
        <a href="/staff/homepage"><button class="button">Step in as Barista</button></a>
        <a href="/manager/managestock"><button class="button">Manage Stock</button></a>
        <a href="/manager/orders"><button class="button">View Orders</button></a>
        <a href="/manager/refunds"><button class="button">View Refunds</button></a>
      </div>
    </div>

    <div style="background-color: rgb(255, 255, 255); height: 100vh; position: relative; overflow: hidden; min-width: 800px;" class="squish">
      <img src="/imgs/dashboard.png" alt="Dashboard" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;">

      <div class="container">
        <div class="glass-card" style="top: 3%; left: 5%; width: 44%; height: 93%;">
          <h1>Pending Online Refunds</h1>
          <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <thead>
            <tr>
              <th>Order ID</th>
              <th>Cost</th>
              <th>Date Ordered</th>
              <th>Status</th>
            </tr>
            </thead>
            <tbody>
            <% if @refunds.empty? %>
              <tr>
                <td>No pending refunds.</td>
              </tr>
            <% else %>
              <% @refunds.each do |order| %>
                <tr>
                  <td><%= order.TransactionId %></td>
                  <td>£<%= order.TotalCost %></td>
                  <td><%= format_date(order.TransactionDate) %></td>
                  <td><%= order.Status %></td>
                  <td>
                    <a href="/manager/refunddetails?transaction_id=<%= order.TransactionId %>">
                      View
                    </a>
                  </td>
              <% end %>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="glass-card" style="top: 3%; left: 53%; width: 44%; height: 93%; text-align: left;">
        <h1>In-Store Refunds</h1>
        <p>Enter UserID</p>
      </div>

    </div>
  </div>
</main>
</body>
</html>