<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <link href="/css/LoginPageTheme.css" rel="stylesheet">
    <title>Register</title>
</head>
<body>
    <header>
        
    </header>
    <main>
        <div style="display: grid;grid-template-columns: 1fr 2fr;" class="squish">
            <div style="background-color: rgb(130 72 24); height: 100vh; padding:15px; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100;">
              <a href="/"><img src="/imgs/home.png" alt="Home" style="width:30px; height:30px;"></a>
              <a href="/user/homepage"><img src="/imgs/ShoppingCart.png" alt="Home" style="width:30px; height:30px;"></a>
                <h1 style="text-align: center;margin-top:20vh;">Register</h1>
                <% if !@form_was_submitted || @submission_error %>
                  <form action="/register" method="post" style="display: flex;flex-direction: column;gap: 2vh;align-items: center;margin-top: 3vh;">
                    <input type="text" name="uname" placeholder="Username" value="<%= h @uname %>" style="width: 25vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;padding-left:10px;">
                    <% if !@uname_error.nil? %>
                      <p style="width: 25vw;height: 1vh;"> <%= @uname_error %></p>
                    <% elsif !@taken_username.nil? %>
                      <p style="width: 25vw;height;1vh;"><%= @taken_username %></p>
                    <% end %>
                    <input type="text" name="email" placeholder="Email Address" value="<%= h @email %>"  style="width: 25vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;padding-left:10px;">
                    <% if !@email_error.nil? %>
                      <p style="width: 25vw;height: 1vh;"> <%= @email_error %></p>
                    <% end %>
                    <input type="password" id="password" name="pword" placeholder="Password" style="width: 25vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;padding-left:10px;">
                    <% if !@password_error.nil? %>
                        <p style="width: 25vw;height: 1vh;"> <%= @password_error %></p>
                    <% end %>
                    <input type="password" id="confirmpassword" name="confirmpword" placeholder="Confirm Password" style="width: 25vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;padding-left:10px;">
                    <% if !@confirmpassword_error.nil? %>
                      <p style="width: 25vw;"> <%= @confirmpassword_error %></p>
                    <% elsif @password_error.nil? && !@invalid_pword.nil? %>
                      <p style="width: 25vw;"> <%= @invalid_pword %> </p>
                    <% elsif @password_error.nil? && !@pword_match_error.nil? %>
                      <p style="width: 25vw;"> <%= @pword_match_error %> </p>
                    <% end %>
                    <button type="submit" style="width: 7vw;height: 5vh;border: 2px solid #69312b;margin: 0vh 8vw 0vh 8vw;border-radius:12px;">Sign Up</button>
                    <p style="margin: 100px">Already have an account? Login <a href="/login" style="color:white;">here</a>.</p>
                  </form>
                <% end %>
            </div>
            <div style="background-color: rgb(255, 255, 255); height: 100vh;">
                <img src="/imgs/CoffeeBeansSplash.png" alt="Whoops, we slipped up!" style="width:100%; height:100%; object-fit: cover;">
                <div style="color: black;width: 51vw;height: 83vh;position: absolute;top: 50%;left: 66.6%;transform: translate(-50%, -50%);background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;">
                    <h1>New deals</h1>
                    <p>This is where new deals will go.</p>
                </div>
            </div>
        </div>
    </main>
    <footer>

    </footer>
</body>