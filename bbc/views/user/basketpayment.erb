<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Payment</title>
    <style>
    button {
      background-color: rgb(130 72 24);
      border: none;
      color: white;
      padding: 10px 20px;
      margin: 40px;
      text-align: center;
      text-decoration: none;
      display: inline-block;
      font: 16pt Helvetica, bold;
    }

    column-buttons {
      display: flex;              
      flex-direction: column;     
      align-items: center;        
      gap: 50px;                  
      margin-top: 50px;           
    }
    </style>
</head>
<body>
    <header>
        <section class="header-bar">
            <nav>
                <ul>
                    <li><a class="smooth-link" href="/user/homepage">Dashboard</a></li>
                    <li><a class="smooth-link" href="/">Log Out</a></li>
                    <li><a class="smooth-link" href="/user/contact_us_page">Contact us</a></li>
                </ul>
            </nav>
        </section>
    </header>

    <main>
        <div style="display: grid; grid-template-columns: 1fr 1fr;">
            <div style="background-color: rgb(130 72 24); height: 100vh; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100;">
            
              <a href="/user/shop" style="text-decoration: none; color: white; font-family: Helvetica; font-weight: bold; display: flex; align-items: center; gap: 5px;">
              <span style="font-size: 20pt;">←</span> Back to Shop
              </a>
              
              <h1 style="text-align: center;position: relative;top: 5vh;">Payment</h1>

              <div style="margin-top: 50px; border-top: 1px solid rgba(255,255,255,0.3); padding-top: 20px; font-family: Helvetica;">

                  <h2 style="color: white;">Order Summary</h2>

                  <% (Basket.getProductNamesForUser(session[:userId])).each do |p| %>
                     <div style="display: flex; justify-content: space-between; margin-top: 10px; font-size: 1.1rem;">
                        <% qty_item = Basket.where(UserId: session[:userId], ProductId: p.ProductId).first %>
                        <span><%= p.ProductName %></span>
                        <span>x<%= qty_item.Quantity %></span>
                     </div>
                  <% end %>

                  <div style="display: flex; justify-content: space-between; margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.3); padding-top: 10px;">
                      <span>Total Items:</span>
                      <span><%= Basket.numOfProductsInBasket(session[:userId]) %></span>
                  </div>
                  
                  <div style="display: flex; justify-content: space-between; margin-top: 10px; font-size: 1.5rem; font-weight: bold; border-top: 2px solid white; padding-top: 10px;">
                      <span>Total:</span>
                      <span>£0.00</span> 
                  </div>

              </div>

              <div style="text-align: center; margin-top: 100px;">
                  <form action="/thankyoupage" method="post">
                      <button type="submit" style="background-color: white; color: rgb(130 72 24); border: 2px solid white; padding: 15px 40px; font-size: 18pt; font-weight: bold; border-radius: 50px; cursor: pointer;">
                          Buy Now
                      </button>
                  </form>
              </div>

            </div>
            <div style="background-color: rgb(255, 255, 255); height: 100vh;">
                <img src="/imgs/CoffeeBeansSplash.png" alt="Whoops, we slipped up!" style="width:100%; height:100%; object-fit: cover;">
            </div>
        </div>
    </main>

    <footer>
        
    </footer>
</body>