<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Payment</title>
    <style>
    button {
      background-color: rgb(130 72 24);
      border: none;
      color: white;
      padding: 10px 20px;
      margin: 40px;
      text-align: center;
      text-decoration: none;
      display: inline-block;
      font: 16pt Helvetica, bold;
    }

    column-buttons {
      display: flex;              
      flex-direction: column;     
      align-items: center;        
      gap: 50px;                  
      margin-top: 50px;           
    }
    </style>
</head>
<body>
    <header>
        <section class="header-bar">
            <nav>
                <ul>
                    <li><a class="smooth-link" href="/user/homepage">Dashboard</a></li>
                    <li><a class="smooth-link" href="/logout">Log Out</a></li>
                    <li><a class="smooth-link" href="/user/contact_us_page">Contact us</a></li>
                </ul>
            </nav>
        </section>
    </header>

    <main>
        <div style="display: grid; grid-template-columns: 1fr 1fr;">
            <div style="background-color: rgb(130 72 24); height: 100vh; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100;">
            
              <a href="/user/shop" style="text-decoration: none; color: white; font-family: Helvetica; font-weight: bold; display: flex; align-items: center; gap: 5px;">
              <span style="font-size: 20pt;">←</span> Back to Shop
              </a>
              
              <h1 style="text-align: center;position: relative;top: 5vh;">Checkout</h1>

              <div style="margin-top: 50px; border-top: 1px solid rgba(255,255,255,0.3); padding-top: 20px; font-family: Helvetica;">

                <h2 style="color: white;">Order Summary</h2>

                    <% total_cost = 0 %>
                    <% cheapestCoffeePrice = 10 %>
                    <% coffees = 0 %>
                    <% beans = 0 %>

                    <% (Basket.getProductNamesForUser(session[:userId])).each do |p| %>
                        <div style="display: flex; justify-content: space-between; margin-top: 10px; font-size: 1.1rem;">
                            <% 
                              item = Basket.where(UserId: session[:userId], ProductId: p.ProductId).last
                              additional_costs = 0

                            if !p.Bean 
                              coffees += 1
                              if cheapestCoffeePrice > p.Price 
                                cheapestCoffeePrice = p.Price
                              end
                              size = item.Size
                              milkType = item.Milk 

                              if size == "Medium"
                                additional_costs -= 1
                              elsif size == "Large"
                                additional_costs += 2
                              end
                              
                              if milkType == "Soy Milk"
                                additional_costs += 1
                              elsif milkType == "Oat Milk"
                                additional_costs += 2
                              end         
                            else 
                              beans += 1
                            end
                            subtotal = (p.Price + additional_costs) * item.Quantity
                            total_cost += subtotal
                            %>
                            <span><%= p.ProductName %> -  <%= size %> -  <%= milkType %> (x<%= item.Quantity %>)</span>
                            <% if additional_costs == 0 %>
                              <span>£<%= '%.2f' % subtotal %></span>
                            <% else %>
                              <span>(+£<%= additional_costs %>) £<%= '%.2f' % subtotal %></span>
                            <% end %>     
                        </div>
                    <% end %>

                    <div style="display: flex; justify-content: space-between; margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.3); padding-top: 10px;">
                        <span>Total Items:</span>
                        <span><%= Basket.num_of_products_in_basket(session[:userId]) %></span>
                    </div>

                    <div style="display: flex; justify-content: space-between; margin-top: 10px; font-size: 1.5rem; font-weight: bold; border-top: 2px solid white; padding-top: 10px;">
                      <span>Subtotal:</span>
                      <span>£<%= '%.2f' % total_cost %></span>
                    </div>
                    
                    <% if session[:userId] != 1 %>
                      <% points = Users.get_loyalty_points(session[:userId])%>
                      <% if beans > 0 
                          points += 3
                          else
                            points += 1
                          end %>
                      <% if points >= 10 %>
                        <div style="margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.3); padding-top: 10px;">
                          <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                            <span>Your Loyalty Points:</span>
                            <span><%= points %></span>
                          </div>
                          <div style="display: flex; justify-content: space-between;">
                            <% if coffees > 0 %>
                              <span> Your Discount:</span>
                              <% if cheapestCoffeePrice > 5 %> 
                                  <% total_cost -=5 %>
                                  <span>-£5</span>
                              <% else %>
                                <span> -£<%= '%.2f' % cheapestCoffeePrice %></span>
                                <% total_cost -= cheapestCoffeePrice %>
                              <% end %>
                            <% end %>
                            </div>
                        </div>
                      <% end %>
                    <% end %>

                    <div style="display: flex; justify-content: space-between; margin-top: 10px; font-size: 1.5rem; font-weight: bold; border-top: 2px solid white; padding-top: 10px;">
                        <span>Total Cost:</span>
                        <span>£<%= '%.2f' % total_cost %></span>
                    </div>
              </div>

              <div style="text-align: center; margin-top: 20px;">
              <% if beans !=0 || coffees != 0 %>
                  <form action="/thankyoupage" method="post">
                      <input type="hidden" name="userId" value="<%= session[:userId] %>">
                      <input type="hidden" name="totalcost" value="<%= total_cost %>">
                      <input type="hidden" name ="beans" value="<%= beans %>">
                      <% if total_cost > 0 %>
                        <h2 style="padding: 15px 40px; font-size: 18pt; font-weight: bold; border-radius: 50px; cursor: pointer;">Payment details</h2>
                        <input type="text" name="card_number" placeholder="Card Number" required style="width: 20vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;padding-left:10px;">
                        <input type="text" name="cvv" placeholder="CVV" required style="width: 10vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;padding-left:10px;">
                        <input type="date" name="expiry_date" placeholder="Expiry Date" required style="widthr: 25vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;padding-left:10px;">
                      <% end %>
                      <h2 style="padding: 15px 40px; font-size: 18pt; font-weight: bold; border-radius: 50px; cursor: pointer;">Delivery</h2>
                      <input type="text" name="address" placeholder="Address" required style="width: 25vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;padding-left:10px;">
                      <input type="text" name="city" placeholder="City" required style="width: 25vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;padding-left:10px;">
                      <input type="text" name="postcode" placeholder="Postcode" required style="width: 25vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;padding-left:10px;">
                      </br>
                      <button type="submit" style="background-color: white; color: rgb(130 72 24); border: 2px solid white; padding: 15px 40px; font-size: 18pt; font-weight: bold; border-radius: 50px; cursor: pointer;">
                          Buy Now
                      </button>
                  </form>
                <% end %>
              </div>

            </div>
            <div style="background-color: rgb(255, 255, 255); height: 100vh;">
                <img src="/imgs/CoffeeBeansSplash.png" alt="Whoops, we slipped up!" style="width:100%; height:100%; object-fit: cover;">
            </div>
        </div>
    </main>

    <footer>
        
    </footer>
</body>