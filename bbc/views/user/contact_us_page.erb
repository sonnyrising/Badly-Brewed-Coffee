<!DOCTYPE html>
<html>
<head>
<title>BBC Help Page</title>
<h1 style="text-align:center; color:white">BBC Help Page</h1>
</head>

<body style="background-color: rgb(130 72 24)">
  <form method="post" action="/user/feedback-page-submit">
    <p style="color:white">Having a problem?</p>
      <input type="text" id="general_issue" name="issue" maxlength="250" size="90" placeholder="Type your message here..." required>

    <p style="color:white">Are you requesting a refund?</p>
      <input type="radio" id="yes" name="request" value="Yes">
      <label for="yes">Yes</label><br>

      <input type="radio" id="no" name="request" value="No" checked>
      <label for="no">No</label><br>

    <p style="color:white">State your reason.. Type 'no' if you are not requesting a refund</p>
      <input type="text" id="refund_reasoning" name="reason" maxlength="250" size="90" placeholder="Type your message here..." required>

    <p style="color:white">Please enter the Transaction ID of your order</p>
      <input type="number" id="transaction_id" name="transaction_id" maxlength="250" size="90" placeholder="Transaction ID" required>

    <p><input type="submit" value="Submit"></p>
  </form>
</body>
</html>