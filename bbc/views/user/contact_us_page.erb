<!DOCTYPE html>
<html>
<head>
    <title>BBC Help Page</title>
    <style>
        /* 1. Navigation Styling */
        header {
            position: absolute;
            top: 0;
            width: 100%;
            z-index: 999;
        }

        .header-bar nav ul {
            display: flex;
            justify-content: flex-end;
            list-style: none;
            gap: 30px;
            padding: 20px 50px;
            margin: 0;
        }

        .smooth-link {
            text-decoration: none;
            color: white;
            font-family: Helvetica, Arial, sans-serif;
            font-weight: bold;
        }

        .smooth-link:hover {
            text-decoration: underline;
        }
            
            .form-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            font-family: Helvetica, Arial, sans-serif;
        }

        input[type="text"], input[type="number"] {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border-radius: 5px;
            border: none;
        }

        input[type="submit"] {
            background-color: white;
            color: rgb(130 72 24);
            border: none;
            padding: 10px 30px;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>

<body style="background-color: rgb(130 72 24); margin: 0; padding: 0;">
    <header>
        <section class="header-bar">
            <nav>
            <ul>
                <li><a href="/user/homepage" class="smooth-link">Dashboard</a></li>
                <li><a href="/user/shop" class="smooth-link">Shop</a></li>
                <% if session[:userId] != 1 %>
                <li><a href="/user/orders" class="smooth-link">Orders</a></li>
                <li><a href="/user/settings" class="smooth-link">Settings</a></li>
                <% end %>
                <li><a href="/user/contact_us_page" class="smooth-link">Contact Us</a></li>
                <li><a href="/logout" class="smooth-link">Logout<a/></li>
            </ul>
            </nav>
        </section>
    </header>

    <div class="form-container">
        <h1 style="text-align:center; color:white; margin-top: 100px;">BBC Help Page</h1>

        <form method="post" action="/user/feedback-page-submit">
            <p style="color:white">Having a problem?</p>
            <input type="text" id="general_issue" name="issue" maxlength="250" placeholder="Type your message here..." required>

            <p style="color:white">Are you requesting a refund?</p>
            <input type="radio" id="yes" name="request" value="Yes">
            <label for="yes" style="color:white">Yes</label><br>

            <input type="radio" id="no" name="request" value="No" checked>
            <label for="no" style="color:white">No</label><br>

            <p style="color:white; margin-top: 20px;">If yes, please provide the ID of the transaction you would like us to refund.</p>
            <input type="number" name="refund_id" required>

            <p style="color:white; margin-top: 20px;">State your reason.. Type 'no' if you are not requesting a refund</p>
            <input type="text" id="refund_reasoning" name="reason" maxlength="250" placeholder="Type your message here..." required>

            <p style="color:white">Please enter the Transaction ID of your order</p>
            <input type="number" id="transaction_id" name="transaction_id" placeholder="Transaction ID" required>

            <p style="margin-top: 30px;">
                <input type="submit" value="Submit">
            </p>
        </form>
    </div>
</body>
</html>