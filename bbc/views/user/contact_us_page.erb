<!DOCTYPE html>
<html>
<head>
<title>BBC Help Page</title>
<h1 style="text-align:center; color:white">BBC Help Page</h1>
</head>

<body style="background-color: rgb(130 72 24)">
  <form method="post" action="/user/feedback-page-submit">
    <p style="color:white">Having a problem?</p>
      <input type="text" name="issue" maxlength="250" size="90" placeholder="Type your message here..." required>

    <p style="color:white">Are you requesting a refund? (Y/N)</p>
      <input type="text" name="request" maxlength="1" size="5" required>

    <p style="color:white">State your reason.. Type 'no' if you are not requesting a refund</p>
      <input type="text" name="reason" maxlength="250" size="90" placeholder="Type your message here..." required>

    <p><input type="submit" value="Submit"></p>
  </form>
</body>
</html>