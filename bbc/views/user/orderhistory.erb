<head>
    <title>Order History</title>
    <link href="/css/GenericTheme.css" rel="stylesheet">
</head>
<body>
    <header style="position: relative; z-index: 100;">       
     <section class="header-bar">
            <nav>
            <ul>
                <li><a href="/user/homepage" class="smooth-link">Dashboard</a></li>
                <li><a href="/user/shop" class="smooth-link">Bean Shop</a></li>
                <% if session[:userId] != 1 %>
                  <li><a href="/user/coffeeshop" class="smooth-link"> Coffee Shop</a></li>
                  <li><a href="/user/orders" class="smooth-link">Orders</a></li>
                  <li><a href="/user/settings" class="smooth-link">Settings</a></li>
                <% end %>
                <li><a href="/user/contact_us_page" class="smooth-link">Contact Us</a></li>
                <li><a href="/logout" class="smooth-link">Logout<a/></li>
            </ul>
            </nav>
        </section>
    </header>

      <main>
          <div style="display: grid; min-height: 100dvh;">
              <img src="/imgs/CoffeeBeansSplash.png" alt="Splash" style="width:100%; height:100%; object-fit: cover; grid-area: 1/1; position: fixed;">
              
              <div style="width:90%; margin: 5vh auto; grid-area: 1/1; color: black; background: transparent; backdrop-filter: blur(15px); box-shadow: 0px 0px 20px 0px #0000007a; border-radius: 30px; text-align: center; padding: 20px; z-index: 10; overflow-y: auto;">
                  <h1>Your Order History</h1>

                  <% if @all_transactions&.any? %>
                      <% @all_transactions.each do |transaction| %>
                          <% items = @orders_with_items[transaction.TransactionId] %>
                          <div style="background: rgba(255,255,255,0.5); margin: 20px auto; padding: 15px; border-radius: 20px; width: 95%; text-align: left; border: 1px solid #824818;">
                              <div style="display: flex; justify-content: space-between; border-bottom: 2px solid #824818; padding-bottom: 10px; margin-bottom: 10px;">

                                  <span><strong>Order Number: <%= transaction.TransactionId %></strong></span>

                                  <% date_str = transaction.TransactionDate.to_s %>
                                  <span><strong>Date:</strong> <%= "#{date_str[0..1]}/#{date_str[2..3]}/#{date_str[4..7]}" %></span>

                                  <span><strong>Total: £<%= '%.2f' % items.sum { |i| i[:Price] * i.Quantity } %></strong></span>
                              </div>
                              
                              <table style="width: 100%; border-collapse: collapse; margin-top: 10px; color: black;">
                                  <tr style="font-weight: bold; border-bottom: 1px solid rgba(0,0,0,0.2);">
                                      <td style="padding: 5px;">Product</td>
                                      <td style="padding: 5px;">Qty</td>
                                      <td style="padding: 5px;">Price (each)</td>
                                      <td style="padding: 5px; text-align: right;">Subtotal</td>
                                  </tr>
                                  <% items.each do |item| %>
                                      <tr style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                                          <td style="padding: 5px;"><%= item[:ProductName] %></td>
                                          <td style="padding: 5px;"><%= item.Quantity %></td>
                                          <td style="padding: 5px;">£<%= '%.2f' % item[:Price] %></td>
                                          <td style="padding: 5px; text-align: right;">£<%= '%.2f' % (item[:Price] * item.Quantity) %></td>
                                      </tr>
                                  <% end %>
                              </table>
                          </div>
                      <% end %>
                  <% else %>
                      <p>No past transactions found.</p>
                  <% end %>
              </div>
          </div>
      </main>

    <footer>
        
    </footer>
</body>