<head>
    <title>Order History</title>
    <link href="/css/GenericTheme.css" rel="stylesheet">
</head>
<body>
    <header>
        <section class="header-bar">
            <nav>
            <ul>
                <li><a href="/user/homepage" class="smooth-link">Dashboard</a></li>
                <li><a href="/user/shop" class="smooth-link">Bean Shop</a></li>
                <% if session[:userId] != 1 %>
                  <li><a href="/user/coffeeshop" class="smooth-link"> Coffee Shop</a></li>
                  <li><a href="/user/orders" class="smooth-link">Orders</a></li>
                  <li><a href="/user/settings" class="smooth-link">Settings</a></li>
                <% end %>
                <li><a href="/user/contact_us_page" class="smooth-link">Contact Us</a></li>
                <li><a href="/logout" class="smooth-link">Logout<a/></li>
            </ul>
            </nav>
        </section>
    </header>

    <main>
        <div style="display: grid; height: 100dvh;">
            <img src="/imgs/CoffeeBeansSplash.png" alt="Whoops, we slipped up!" style="width:100%; height:100dvh; object-fit: cover; grid-area: 1/1;">
            <div style="width:90%; height: 80%; margin: auto auto; grid-area: 1/1; color: black; background: transparent; backdrop-filter: blur(15px); box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;">
                <h1>Recent Transactions</h1>
                <table style="width: 90%; overflow-y: scroll; margin: 0 auto;">
                    <tr style="text-align: center; color: black;">
                        <td>Items</td>
                        <td>Date</td>
                        <td>Price</td>
                    </tr>
                    
                    <% if @shown_orders&.any? %>
                        <% @shown_orders.each do |order| %>
                            <tr style="text-align: center; color: black;">
                                <td><%= order.UserId %></td>
                                <td><%= order.TransactionDate %></td>
                                <td>£<%= order.TotalCost %></td>
                            </tr>
                        <% end %>
                    <% else %>
                        <tr><td colspan="3" style="text-align:center; color:black;">No past transactions.</td></tr>
                    <% end %>
                </table>
            </div>
        </div>
    </main>

    <footer>
        
    </footer>
</body>