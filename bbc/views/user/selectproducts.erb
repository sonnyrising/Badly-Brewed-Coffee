<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Basket</title>
    <style>

      body, html {
        margin: 0;
        padding: 0;
        height: 100v;
        overflow:visible;
      }

      header {
        position: absolute;
        top: 0;
        width: 100%;
        z-index: 999;
      }

      button {
      background-color: rgb(130 72 24);
      border: none;
      color: white;
      padding: 10px 20px;
      margin: 40px;
      text-align: center;
      text-decoration: none;
      display: inline-block;
      font: 16pt Helvetica, bold;
      }

      column-buttons {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 50px;
      margin-top: 50px;
      }

      .layout-grid {
      display: grid;
      grid-template-columns: 20vw 80vw;
      height: 100vh;
      }

      .sidebar {
      background-color: rgb(130 72 24);
      height: 100vh;
      padding: 15px;
      box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3);
      z-index: 100;
      color: white;
      }

      .display-area {
      background-image: url('/imgs/CoffeeBeansSplash.png');
      background-size: cover;
      background-position: center;
      position: relative;
      height: 100vh;
      }

      .product-box {
      color: black;
      background: rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(15px);
      box-shadow: 0px 0px 20px 0px #0000007a;
      border-radius: 30px;
      text-align: center;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      transition: transform 0.3s ease;
      }

      .product-box:hover {
      transform: scale(1.02);
      }

      .product-inner-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, 1fr);
      gap: 30px;
      width: 90%;
      height: 80%;
      margin: 5% auto;
      }
     
      .product-image {
      width: 100px;
      height: 100px;
      object-fit: cover; /* This crops the image to a perfect square */
      border-radius: 15px; /* Matches the rounded look of your boxes */
      margin-bottom: 15px;
      }
      
    .basket-icon-wrapper {
      position: relative;
      display: inline-block;
    }

    .basket-img {
      width: 45px; 
      height: 45px;
      object-fit: contain;
    }

    .basket-count-badge {
      position: absolute;
      top: -8px;
      right: -8px;
      background-color: #ff4444;
      color: white;
      border-radius: 50%;
      padding: 2px 7px;
      font-size: 11px;
      font-weight: bold;
      box-shadow: 0px 2px 4px rgba(0,0,0,0.5);
      border: 1px solid white; 
    }

    .sidebar-item {
      display: grid;
      grid-template-columns: 1fr auto auto;
      align-items: center;
      gap: 10px;
      padding: 10px;
      margin-bottom: 8px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      color: white;
    }

    .qty-tag {
      background: white;
      color: rgb(130 72 24);
      padding: 1px 6px;
      border-radius: 10px;
      font-weight: bold;
      font-size: 0.8em;
    }
    .qty-btn{
      padding: 4px 8px;
      margin: 0;
      font-size: 12px;
      width: 28px;
      height: 28px;
      border-radius: 6px;
      background-color: rbg(130 72 24);
      color: white;
      cursor: pointer;
    }
    .buttons{
      display: flex;
      gap: 5px;
      align-items: center;
    }
    .bin{
      background: none;
      border: none;
      padding: 0px;
      margin: 0px;
      cursor: pointer;
      display: flex;
      align-items:center;
      justify-content: center;
    }
    
    .bin img{
      width: 25px;
      height: 25px;
      object-fit: contain;
    }
    </style>
</head>
<body>
    <header>
        <section class="header-bar">
            <nav>
                <ul>
                    <li><a class="smooth-link" href="/user/homepage">Dashboard</a></li>
                    <li><a class="smooth-link" href="/user/basketpayment">Basket</a></li>
                    <li><a class="smooth-link" href="/user/contact_us_page">Contact us</a></li>
                    <li><a class="smooth-link" href="/logout">Log Out</a></li>
                </ul>
            </nav>
        </section>
    </header>

    <main>
        <div class="layout-grid">
          <div class="sidebar">
              <h1 style="text-align: center;">Shop</h1>

              <div style="text-align: center;">
                <div class="basket-icon-wrapper">
                  <img src="/imgs/ShoppingCart.png" class="basket-img" alt="Basket">
                  <span class="basket-count-badge">
                    <%= Basket.numOfProductsInBasket(session[:userId]) %>
                  </span>
                </div>
              </div>

              <div style="margin-top: 40px; padding: 0 10px;">
                <% (Basket.getProductNamesForUser(session[:userId])).each do |p| %>
                  <% if Basket.finishedTransaction(p.ProductId, session[:userId]) %>
                  <div class="sidebar-item">
                    <span style="font-size: 0.9em; font-weight: bold;"><%= p.ProductName %></span>
                    <div class="buttons">
                      <form action="/user/shop/add" method="post">
                        <input type="hidden" name="userId" value="<%= session[:userId] %>">
                        <input type="hidden" name="productId" value="<%= p.ProductId %>">
                        <button type="submit" class="qty-btn">+</button>
                      </form>
                      <form action="/user/shop/subtract" method="post">
                        <input type="hidden" name="userId" value="<%= session[:userId] %>">
                        <input type="hidden" name="productId" value="<%= p.ProductId %>">
                        <button type="submit" class="qty-btn">-</button>
                      </form>
                      <form action="/user/shop/delete" method="post">
                        <input type="hidden" name="userId" value="<%= session[:userId] %>">
                        <input type="hidden" name="productId" value="<%= p.ProductId %>">
                        <button type="submit" class="bin"><img src="/imgs/bin.png" alt="Delete"></button>
                      </form>
                    </div>
                    <span class="qty-tag">x<%= Basket.where(UserId: session[:userId], ProductId: p.ProductId).first.Quantity %></span>
                  </div>
                  <% end %>
                <% end %>

                <form action="/user/basketpayment" method="post" style="text-align: center;">
                  <button type="submit" style="width: 100%; margin: 20px 0; border-radius: 10px;">Checkout</button>
                </form>
              </div>
          </div>
            <div class="display-area">
                <div class="product-inner-grid">
                <% @products.each do |product| %>
                    <%= erb :"user/product", locals: { p: product } %>
                <% end %>
                </div>
            </div>
        </div>
    </main>

    <footer></footer>
</body>
</html>