<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <title>Basket</title>
    <style>
      body, html {
        margin: 0;
        padding: 0;
        height: 100vh;
        overflow:visible;
      }

      header {
        position: absolute;
        top: 0;
        width: 100%;
        z-index: 999;
      }

      button {
        background-color: rgb(130 72 24);
        border: none;
        color: white;
        padding: 10px 20px;
        margin: 40px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font: 16pt Helvetica, bold;
      }

      .column-buttons {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 50px;
        margin-top: 50px;
      }

      .layout-grid {
        display: grid;
        grid-template-columns: 20vw 80vw;
        height: 100vh;
      }

      .sidebar {
        background-color: rgb(130 72 24);
        padding: 15px;
        box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3);
        z-index: 100;
        color: white;
      }

      .display-area {
        background-image: url('/imgs/CoffeeBeansSplash.png');
        background-size: cover;
        background-position: center;
        position: relative;
        height: 100vh;
      }

      .product-box {
        color: black;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(15px);
        box-shadow: 0px 0px 20px 0px #0000007a;
        border-radius: 30px;
        text-align: center;
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        transition: transform 0.3s ease;
      }

      .product-box:hover {
        transform: scale(1.02);
      }

      .product-inner-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(2, 1fr);
        gap: 30px;
        width: 90%;
        height: 90%;
        margin: 5% auto;
        overflow-y: scroll;
      }
     
      .product-image {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 15px;
        margin-bottom: 15px;
      }
      
      .basket-icon-wrapper {
        position: relative;
        display: inline-block;
      }

      .basket-img {
        width: 45px; 
        height: 45px;
        object-fit: contain;
      }

      .basket-count-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        background-color: #ff4444;
        color: white;
        border-radius: 50%;
        padding: 2px 7px;
        font-size: 11px;
        font-weight: bold;
        box-shadow: 0px 2px 4px rgba(0,0,0,0.5);
        border: 1px solid white; 
      }

      .sidebar-item {
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 10px;
        padding: 10px;
        margin-bottom: 8px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        color: white;
      }

      .qty-tag {
        background: white;
        color: rgb(130 72 24);
        padding: 1px 6px;
        border-radius: 10px;
        font-weight: bold;
        font-size: 0.8em;
      }
      .qty-btn{
        padding: 4px 8px;
        margin: 0;
        font-size: 12px;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background-color: rgb(130 72 24);
        color: white;
        cursor: pointer;
      }
      .buttons{
        display: flex;
        gap: 5px;
        align-items: center;
      }
      .bin{
        background: none;
        border: none;
        padding: 0px;
        margin: 0px;
        cursor: pointer;
        display: flex;
        align-items:center;
        justify-content: center;
      }
    
      .bin img{
        width: 25px;
        height: 25px;
        object-fit: contain;
      }

      .out-of-stock {
        opacity: 0.8;
        pointer-events: none;
        position: relative;
      }

      .out-of-stock .product-image {
        filter: grayscale(100%);
      }

      .sold-out-banner {
        background-color: #ff0000;
        color: white;
        padding: 10px 0;
        width: 100%;
        font-weight: bold;
        text-align: center;
        position: absolute;
        top: 40%;
        z-index: 99;
        box-shadow: 0px 4px 8px rgba(0,0,0,0.4);
      }
      
    </style>
</head>
<body>
    <header>
      <section class="header-bar">
          <nav>
          <ul>
              <li><a href="/user/homepage" class="smooth-link">Dashboard</a></li>
              <li><a href="/user/shop" class="smooth-link">Bean Shop</a></li>
              <% if session[:userId] != 1 %>
                <li><a href="/user/coffeeshop" class="smooth-link"> Coffee Shop</a></li>
                <li><a href="/user/orders" class="smooth-link">Orders</a></li>
                <li><a href="/user/settings" class="smooth-link">Settings</a></li>
              <% end %>
              <li><a href="/user/contact_us_page" class="smooth-link">Contact Us</a></li>
            <li><a href="/logout" class="smooth-link">Logout</a>></li>
          </ul>
          </nav>
      </section>
    </header>

    <main>
        <div class="layout-grid">
          <div class="sidebar">
              <h1 style="text-align: center;">Beans</h1>

              <div style="text-align: center;">
                <div class="basket-icon-wrapper">
                  <img src="/imgs/ShoppingCart.png" class="basket-img" alt="Basket">
                  <span class="basket-count-badge">
                    <%= Basket.numOfProductsInBasket(session[:userId]) %>
                  </span>
                </div>
              </div>

              <div style="margin-top: 40px; padding: 0 10px;">
                <% (Basket.getProductNamesForUser(session[:userId])).each do |p| %>
                  <% if Basket.finishedTransaction(p.ProductId, session[:userId])%>
                    <div class="sidebar-item">
                      <span style="font-size: 0.9em; font-weight: bold;"><%= p.ProductName %></span>
                        <div class="buttons">
                          <form action="/user/shop/add" method="post">
                            <input type="hidden" name="userId" value="<%= session[:userId] %>">
                            <input type="hidden" name="productId" value="<%= p.ProductId %>">
                            <button type="submit" class="qty-btn">+</button>
                          </form>
                          <form action="/user/shop/subtract" method="post">
                            <input type="hidden" name="userId" value="<%= session[:userId] %>">
                            <input type="hidden" name="productId" value="<%= p.ProductId %>">
                            <button type="submit" class="qty-btn">-</button>
                          </form>
                          <form action="/user/shop/delete" method="post">
                            <input type="hidden" name="userId" value="<%= session[:userId] %>">
                            <input type="hidden" name="productId" value="<%= p.ProductId %>">
                            <button type="submit" class="bin"><img src="/imgs/bin.png" alt="Delete"></button>
                          </form>
                        </div>
                      <span class="qty-tag">x<%= Basket.where(UserId: session[:userId], ProductId: p.ProductId).last.Quantity %></span>
                    </div>
                  <% end %>
                <% end %>

                <form action="/user/basketpayment" method="post" style="text-align: center;">
                  <button type="submit" style="width: 100%; margin: 20px 0; border-radius: 10px; cursor: pointer;">Checkout</button>
                </form>
              </div>
          </div>
          <div class="display-area" style="height: 100vh; overflow-y: auto;"> 
            <div class="filter-container" style="padding: 20px 20px 0px 20px; margin-bottom: 0px;">
              <form method="post" action="/user/filter" style="margin: 0px 0 0px 22vw; padding: 0;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <input type="text" name="search" placeholder="Search..." style="width: 200px; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                  <button type="submit" name="submit" style="background-color: #7d461b; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer;">Search</button>
                  <button type="submit" name="clear" value="true" style="background-color: #f4f4f4; color: #333; border: 1px solid #ccc; padding: 8px 15px; border-radius: 4px; cursor: pointer;">Clear</button>
                </div>
              </form>
            </div> 
            <div class="product-inner-grid" style="margin-top: 0;">
              <% @products.each do |product| %>
                <%= erb :"user/product", locals: { p: product } %>
              <% end %>
            </div>
          </div>
        </div>
    </main>

    <footer></footer>
</body>
</html>