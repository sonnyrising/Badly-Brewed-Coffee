  <!DOCTYPE html>
  <head>
      <link href="/css/GenericTheme.css" rel="stylesheet">
      <title>Settings</title>
  </head>
  <body>
      <header style="position: relative; z-index: 100;">
          <section class="header-bar">
              <nav>
              <ul>
                  <li><a href="/user/homepage" class="smooth-link">Dashboard</a></li>
                  <li><a href="/user/shop" class="smooth-link">Bean Shop</a></li>
                  <% if session[:userId] != 1 %>
                  <li><a href="/user/coffeeshop" class="smooth-link"> Coffee Shop</a></li>
                  <li><a href="/user/orders" class="smooth-link">Orders</a></li>
                  <li><a href="/user/settings" class="smooth-link">Settings</a></li>
                  <% end %>
                  <li><a href="/user/contact_us_page" class="smooth-link">Contact Us</a></li>
                  <li><a href="/logout" class="smooth-link">Logout<a/></li>
              </ul>
              </nav>
          </section>
      </header>

      <main>
          <div style="display: grid; grid-template-columns: 1fr 1fr;">
              <div style="background-color: rgb(130 72 24); height: 100vh; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100;">
                  <h1 style="text-align: center;position: relative;top: 5vh;">Settings</h1>

                  <div style="background: rgba(255,255,255,0.1); padding: 20px; border-radius: 15px; margin-bottom: 30px;">
                    <p style="margin: 5px 0; font-size: 1.1em;"><strong>User ID:</strong> #<%= @user.UserId %></p>
                    <p style="margin: 5px 0; font-size: 1.1em;"><strong>Loyalty Points:</strong> <%= @user.LoyaltyPoints %></p>
                    <p style="margin: 5px 0; font-size: 1.1em;"><strong>Member Since:</strong> <%= @user.DateJoined %></p>
                  </div>

                  
              </div>

              <div style="background-color: rgb(255, 255, 255); height: 100vh;">
                  <img src="/imgs/CoffeeBeansSplash.png" alt="Whoops, we slipped up!" style="width:100%; height:100%; object-fit: cover;">
              </div>
              
          </div>
      </main>

      <footer>
          
      </footer>
  </body>