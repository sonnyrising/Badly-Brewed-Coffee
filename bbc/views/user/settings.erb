  <!DOCTYPE html>
  <head>
      <link href="/css/GenericTheme.css" rel="stylesheet">
      <title>Settings</title>
  </head>
  <body>
      <header style="position: relative; z-index: 100;">
          <section class="header-bar">
              <nav>
              <ul>
                  <li><a href="/user/homepage" class="smooth-link">Dashboard</a></li>
                  <li><a href="/user/shop" class="smooth-link">Bean Shop</a></li>
                  <% if session[:userId] != 1 %>
                  <li><a href="/user/coffeeshop" class="smooth-link"> Coffee Shop</a></li>
                  <li><a href="/user/orders" class="smooth-link">Orders</a></li>
                  <li><a href="/user/settings" class="smooth-link">Settings</a></li>
                  <% end %>
                  <li><a href="/user/contact_us_page" class="smooth-link">Contact Us</a></li>
                  <li><a href="/logout" class="smooth-link">Logout</a></li>
              </ul>
              </nav>
          </section>
      </header>

      <main>
          <div style="display: grid; grid-template-columns: 1fr 1fr;">
              <div style="background-color: rgb(130 72 24); height: 100vh; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100;">
                <h1 style="text-align: center; margin-top: 5vh; margin-bottom: 4vh;">Account Settings</h1>
                   <% if @success_message %>
                      <div style="background-color: rgba(76, 175, 80, 0.9); color: white; padding: 15px; border-radius: 10px; text-align: center; margin-bottom: 30px; font-weight: bold; border: 1px solid #4CAF50; box-shadow: 0 4px 6px rgba(0,0,0,0.2);">
                        <%= @success_message %>
                      </div>
                    <% end %>

                    <% if @error_message %>
                      <div style="background-color: rgba(244, 67, 54, 0.9); color: white; padding: 15px; border-radius: 10px; text-align: center; margin-bottom: 30px; font-weight: bold; border: 1px solid #F44336; box-shadow: 0 4px 6px rgba(0,0,0,0.2);">
                        <%= @error_message %>
                      </div>
                    <% end %>

                  <div style="background: rgba(255,255,255,0.1); padding: 20px; border-radius: 15px; margin-bottom: 30px;">
                      <p style="margin: 5px 0; font-size: 1.1em;"><strong>User ID:</strong> #<%= @user.UserId %></p>
                    <p style="margin: 5px 0; font-size: 1.1em;"><strong>Loyalty Points:</strong> <%= @user.LoyaltyPoints %></p>
                    <p style="margin: 5px 0; font-size: 1.1em;"><strong>Member Since:</strong> <%= @user.DateJoined %></p>
                  </div>

                <form action="/user/update_settings" method="POST">
                    <div style="margin-bottom: 20px;">
                        <label style="display: block; margin-bottom: 8px; font-weight: bold; font-size: 1.1em;">Username</label>
                        <input type="text" name="username" value="<%= @user.Username %>" 
                               style="width: 100%; padding: 12px; border-radius: 8px; border: none; background: rgba(255,255,255,0.9); color: #333; font-size: 1em; box-sizing: border-box;">
                    </div>

                    <div style="margin-bottom: 30px;">
                        <label style="display: block; margin-bottom: 8px; font-weight: bold; font-size: 1.1em;">Email Address</label>
                        <input type="email" name="email" value="<%= @user.Email %>" 
                               style="width: 100%; padding: 12px; border-radius: 8px; border: none; background: rgba(255,255,255,0.9); color: #333; font-size: 1em; box-sizing: border-box;">
                    </div>

                   <button type="submit" style="width: 100%; padding: 10px; border-radius: 20px; border: 2px solid white; background: transparent; color: white; font-weight: bold; font-size: 1em; cursor: pointer;">
                        Save Changes
                    </button>
                </form>

              </div>
              <div style="background-color: rgb(255, 255, 255); height: 100vh;">
                  <img src="/imgs/CoffeeBeansSplash.png" alt="Whoops, we slipped up!" style="width:100%; height:100%; object-fit: cover;">
              </div>
          </div>
      </main>

      <footer>
          
      </footer>
  </body>