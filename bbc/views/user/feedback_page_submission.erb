<!DOCTYPE html>
<html>
<head>
  <title>Post Feedback Submission Page</title>
    <h1 style="background-color: rgb(130 72 24); color:white; text-align: center">Thank you for letting us know! We will update you when the issue is handled with<b></b></h1>
    <link rel="stylesheet" href="style/style.css">
</head>

<body style="text-align: center; background-color: rgb(130 72 24)">

  <% if @feedback.RefundRequest == "Yes" %>
    <h3 style="background-color: rgb(130 72 24); color:white">Your refund request has been received</h3>
    <p style="background-color: rgb(130 72 24); color:white">Your refund ticket number is : <strong><%= @feedback.TicketNumber %> </strong></p>
  <% else %>
    <h4 style="background-color: rgb(130 72 24); color:white">We appreciate you letting us know and helping us to increase the quality of our overall services</h4>
  <% end %>

  <div style="text-align:center">
    <a href="/user/homepage" style="color:white; text-align: center">Back to menu</a>
  </div>
  
</body>
</html>