<!DOCTYPE html>
<head>
    <link href="/css/GenericTheme.css" rel="stylesheet">
    <link href="/css/ModularElements.css" rel="stylesheet">
    <link href="/css/LoginPageTheme.css" rel="stylesheet">
    <title>Login</title>
</head>
<body>
    <header>
        
    </header>
    <main>
        <div class="half-grid squish">
            <div style="background-color: rgb(136, 73, 44); height: 100vh; box-shadow: 11px 5px 15px rgba(0, 0, 0, 0.3); z-index: 100;">
                <h1 style="text-align: center;position: relative;top: 5vh;">Login</h1>
                <form action="/login" method="post">
                    <input type="text" id="username" name="uname" placeholder="Username" required style="width: 25vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;position: relative;left: 50%;top: 20vh;transform: translateX(-50%);">
                    <br>
                    <input type="password" id="password" name="pword" placeholder="Password" required style="width: 25vw;height: 5vh;border: 2px solid #69312b;border-radius: 15px;position: relative;left: 50%;top: 21vh;transform: translateX(-50%);">
                    <br>
                    <button type="submit" style="position: relative;top: 23vh;left: 50%;transform: translateX(-50%);width: 7vw;height: 5vh;border: 2px solid #69312b;border-radius: 7px;">Log in</button>
                </form>
                <p style="position: absolute;top: 90vh;left: 16%;transform: translateX(-50%);">Don't have an account? Sign up <a href="/" style="color:white;">here</a>.</p>
            </div>
            <div style="background-color: rgb(255, 255, 255); height: 100vh;">
                <img src="/imgs/CoffeeBeansSplash.png" alt="Whoops, we slipped up!" style="width:100%; height:100%; object-fit: cover;">
                <div class="fade-in-delay" style="color: black;width: 51vw;height: 83vh;position: absolute;top: 50%;left: 66.6%;transform: translate(-50%, -50%);background: transparent;backdrop-filter: blur(15px);box-shadow: 0px 0px 20px 0px #0000007a;border-radius: 30px; text-align: center;">
                    <h1>New deals</h1>
                    <p>This is where new deals will go.</p>
                </div>
            </div>
        </div>
    </main>
    <footer>

    </footer>
</body>